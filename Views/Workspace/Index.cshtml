@model List<StartupConnect.Services.MyTeamItem>
@using StartupConnect.Infrastructure
@{
    ViewData["Title"] = "My Teams";
    var ideasWithoutTeam = ViewBag.IdeasWithoutTeam as List<(int Id, string Title)> ?? new();
    var now = DateTime.UtcNow;
}

<section class="sc-page-header">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1><i class="bi bi-people me-2"></i>My Teams</h1>
            <p class="opacity-75 mb-0">Every startup team you're part of — chat, milestones and progress in one place.</p>
        </div>
        <a asp-controller="Matches" asp-action="FindTeam" class="btn btn-accent"><i class="bi bi-search me-1"></i>Find teammates</a>
    </div>
</section>

<div class="container pb-5">
    @if (!Model.Any())
    {
        <div class="sc-empty-state">
            <div class="sc-empty-icon"><i class="bi bi-people"></i></div>
            <h5>You're not on a team yet</h5>
            <p class="text-muted mb-3">Teams form when a founder accepts a collaboration request. Show interest in an idea you'd love to build, or open a workspace for your own approved idea.</p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a asp-controller="Ideas" asp-action="Browse" class="btn btn-primary-sc"><i class="bi bi-compass me-1"></i>Explore ideas</a>
                <a asp-controller="Interests" asp-action="Manage" class="btn btn-outline-secondary"><i class="bi bi-briefcase me-1"></i>My collaboration requests</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var t in Model)
            {
                var pct = t.MilestonesTotal == 0 ? 0 : (int)Math.Round(100.0 * t.MilestonesDone / t.MilestonesTotal);
                <div class="col-md-6 col-xl-4">
                    <article class="sc-team-card h-100">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <span class="badge sc-team-status sc-team-status-@t.Status.ToString().ToLowerInvariant()">@t.Status</span>
                            <span class="badge @(t.IsFounder ? "bg-warning-subtle text-warning-emphasis" : "bg-primary-subtle text-primary")">
                                <i class="bi @(t.IsFounder ? "bi-star-fill" : "bi-person-badge") me-1"></i>@t.MyRole
                            </span>
                        </div>
                        <h5 class="fw-bold mb-1">
                            <a asp-action="Team" asp-route-id="@t.TeamId" class="stretched-link text-dark text-decoration-none">@t.IdeaTitle</a>
                        </h5>
                        <p class="small text-muted sc-clamp-2 mb-3">@t.IdeaTagline</p>

                        <div class="d-flex align-items-center mb-3">
                            <div class="sc-avatar-stack me-2">
                                @foreach (var name in t.MemberNames.Take(5))
                                {
                                    <partial name="_Avatar" model="@(new AvatarModel(name, null, 30))" />
                                }
                            </div>
                            <span class="small text-muted">@t.MemberNames.Count member@(t.MemberNames.Count == 1 ? "" : "s")</span>
                        </div>

                        <div class="small d-flex justify-content-between mb-1">
                            <span class="text-muted">Milestones</span>
                            <span class="fw-semibold">@t.MilestonesDone/@t.MilestonesTotal</span>
                        </div>
                        <div class="progress sc-milestone-progress mb-3" style="height:6px"><div class="progress-bar" style="width:@pct%"></div></div>

                        <div class="sc-team-last small text-muted">
                            @if (t.LastMessage != null)
                            {
                                <i class="bi bi-chat-dots me-1"></i><strong>@t.LastMessage.SenderName:</strong>
                                <span class="sc-clamp-1">@t.LastMessage.Content</span>
                                <span class="d-block mt-1">@AppTime.Ago(t.LastMessage.SentAt, now)</span>
                            }
                            else
                            {
                                <span><i class="bi bi-chat me-1"></i>No messages yet — say hello!</span>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }

    @if (ideasWithoutTeam.Any())
    {
        <div class="sc-form-card mt-5">
            <h6 class="fw-bold mb-1"><i class="bi bi-plus-circle me-1 text-primary"></i>Start a workspace for your idea</h6>
            <p class="small text-muted mb-3">Plan milestones on your own now — teammates you accept later join the same workspace.</p>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var idea in ideasWithoutTeam)
                {
                    <a asp-action="ForIdea" asp-route-id="@idea.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-kanban me-1"></i>@idea.Title</a>
                }
            </div>
        </div>
    }
</div>
