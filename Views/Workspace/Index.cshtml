@{
    ViewData["Title"] = "Collaboration Workspace";
    var team = ViewBag.Team as StartupConnect.Models.Team;
    var messages = ViewBag.Messages as List<StartupConnect.Models.TeamMessage>;
    var milestones = ViewBag.Milestones as List<StartupConnect.Models.IdeaMilestone>;
}

<div class="container-fluid py-4">
    <div class="row h-100 g-4">
        <!-- Sidebar: Milestones -->
        <div class="col-lg-4 col-xl-3">
            <div class="card sc-idea-card h-100">
                <div class="card-header bg-transparent border-bottom">
                    <h5 class="fw-bold mb-0">Milestones</h5>
                </div>
                <div class="card-body overflow-auto" style="max-height: calc(100vh - 200px);">
                    @if(milestones != null && milestones.Any())
                    {
                        foreach(var m in milestones)
                        {
                            <div class="card mb-3 border @(m.IsCompleted ? "border-success bg-white" : "")">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-1">@m.Title</h6>
                                    <p class="text-muted small mb-2">@m.Description</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge @(m.IsCompleted ? "bg-success" : "bg-warning")">
                                            @(m.IsCompleted ? "Completed" : "Pending")
                                        </span>
                                        @if(m.DueDate.HasValue)
                                        {
                                            <small class="text-muted"><i class="bi bi-calendar"></i> @m.DueDate.Value.ToString("MMM dd")</small>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">No milestones created yet.</p>
                    }
                    <button class="btn btn-outline-primary w-100 mt-2">
                        <i class="bi bi-plus-circle me-1"></i> Add Milestone
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Chat Area -->
        <div class="col-lg-8 col-xl-9">
            <div class="card sc-idea-card h-100 d-flex flex-column">
                <div class="card-header bg-transparent border-bottom p-3">
                    <h4 class="fw-bold mb-0">Team Chat - @team?.Idea?.Title</h4>
                </div>
                <div class="card-body flex-grow-1 overflow-auto d-flex flex-column-reverse p-4" style="max-height: calc(100vh - 280px);">
                    @if(messages != null && messages.Any())
                    {
                        foreach(var msg in messages)
                        {
                            var isMine = msg.SenderUserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                            <div class="d-flex mb-3 @(isMine ? "justify-content-end" : "justify-content-start")">
                                <div class="message-bubble p-3 rounded-4 shadow-sm @(isMine ? "bg-primary text-black" : "bg-white")" style="max-width: 75%;">
                                    @if(!isMine)
                                    {
                                        <div class="small fw-bold mb-1 opacity-75">@msg.Sender?.FullName</div>
                                    }
                                    <div>@msg.Content</div>
                                    <div class="small mt-1 text-end @(isMine ? "text-black-50" : "text-muted")" style="font-size: 0.7rem;">
                                        @msg.SentAt.ToString("HH:mm")
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted my-auto">
                            <i class="bi bi-chat-dots display-4 mb-3 d-block"></i>
                            <p>Start the conversation with your team!</p>
                        </div>
                    }
                </div>
                <div class="card-footer bg-transparent border-top p-3">
                    <form asp-action="SendMessage" method="post" class="d-flex gap-2">
                        <input type="hidden" name="teamId" value="@team?.Id" />
                        <input type="text" name="content" class="form-control rounded-pill px-4" placeholder="Type your message..." required maxlength="2000" autocomplete="off" />
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
