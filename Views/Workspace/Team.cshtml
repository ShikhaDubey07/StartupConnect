@model WorkspaceViewModel
@using StartupConnect.Infrastructure
@using StartupConnect.Models
@using StartupConnect.Services
@{
    ViewData["Title"] = Model.TeamName;
    ViewData["TeamId"] = Model.TeamId;
    ViewData["IsFounder"] = Model.IsFounder;
    ViewData["IsClosed"] = Model.IsClosed;
    var me = Model.Members.FirstOrDefault(m => m.UserId == Model.CurrentUserId);
}

<section class="sc-page-header sc-workspace-header">
    <div class="container">
        <a asp-action="Index" class="small text-decoration-none d-inline-block mb-2 sc-hero-back"><i class="bi bi-arrow-left me-1"></i>My Teams</a>
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div class="min-w-0">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <span class="badge sc-team-status sc-team-status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span>
                    <span class="small opacity-75"><i class="bi bi-tag me-1"></i>@Model.IdeaCategory</span>
                </div>
                <h1 class="mb-1 text-break">@Model.TeamName</h1>
                <p class="opacity-75 mb-0">
                    @if (Model.IdeaStatus == IdeaStatus.Approved)
                    {
                        <a asp-controller="Ideas" asp-action="Detail" asp-route-id="@Model.IdeaId" class="text-reset">@Model.IdeaTitle</a>
                    }
                    else
                    {
                        @Model.IdeaTitle
                    }
                    · you're <strong>@(me?.Role ?? "a member")</strong>
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (Model.IsFounder)
                {
                    <form asp-action="SetStatus" method="post" class="d-flex gap-2 align-items-center">
                        <input type="hidden" name="teamId" value="@Model.TeamId" />
                        <label for="teamStatus" class="visually-hidden">Team status</label>
                        <select id="teamStatus" name="status" class="form-select form-select-sm w-auto">
                            @foreach (var st in Enum.GetValues<TeamStatus>())
                            {
                                <option value="@st" selected="@(st == Model.Status)">@st</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary-sc">Update status</button>
                    </form>
                }
                else
                {
                    <form asp-action="Leave" method="post" onsubmit="return confirm('Leave this team? You will lose access to the chat and milestones.');">
                        <input type="hidden" name="teamId" value="@Model.TeamId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-box-arrow-left me-1"></i>Leave team</button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

<div class="container pb-5">
    @if (Model.IsClosed)
    {
        <div class="alert alert-secondary d-flex align-items-center gap-2">
            <i class="bi bi-archive"></i>
            <span>This team is <strong>closed</strong>. Chat and milestones are read-only@(Model.IsFounder ? " — change the status above to reopen it." : ".")</span>
        </div>
    }

    <div class="row g-4">
        <!-- Chat -->
        <div class="col-lg-8" id="chat">
            <div class="sc-chat-card">
                <div class="sc-chat-header">
                    <div>
                        <h5 class="fw-bold mb-0"><i class="bi bi-chat-dots me-2 text-primary"></i>Team chat</h5>
                        <small class="text-muted">Only team members can see these messages.</small>
                    </div>
                    <span class="sc-live-indicator" id="chatStatus" data-state="connecting"><span class="dot"></span><span class="label">Connecting…</span></span>
                </div>
                <div class="sc-chat-body" id="chatBody" aria-live="polite">
                    <div class="text-center mb-2 @(Model.HasOlderMessages ? "" : "d-none")" id="loadOlderWrap">
                        <button type="button" class="btn btn-sm btn-light border" id="loadOlderBtn"><i class="bi bi-arrow-up me-1"></i>Load earlier messages</button>
                    </div>
                    <div id="chatMessages"></div>
                    <div class="sc-chat-empty text-center text-muted @(Model.Messages.Any() ? "d-none" : "")" id="chatEmpty">
                        <i class="bi bi-chat-heart fs-1 d-block mb-2"></i>
                        <p class="mb-0">No messages yet. Kick things off — share your plan for this week!</p>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-primary sc-new-msg-pill d-none" id="newMsgPill"><i class="bi bi-arrow-down me-1"></i>New messages</button>
                <div class="sc-chat-footer">
                    @if (Model.IsClosed)
                    {
                        <div class="text-muted small text-center py-1"><i class="bi bi-lock me-1"></i>Chat is read-only while the team is closed.</div>
                    }
                    else
                    {
                        <form asp-action="SendMessage" method="post" id="chatForm" class="d-flex gap-2 align-items-end">
                            <input type="hidden" name="teamId" value="@Model.TeamId" />
                            <label for="chatInput" class="visually-hidden">Message</label>
                            <textarea name="content" id="chatInput" class="form-control sc-chat-input" rows="1" placeholder="Message your team…" title="Enter to send · Shift+Enter for a new line" required maxlength="@TeamService.MaxMessageLength" autocomplete="off"></textarea>
                            <button type="submit" class="btn btn-primary-sc rounded-pill px-3" id="chatSend" aria-label="Send"><i class="bi bi-send-fill"></i></button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar: idea summary + members -->
        <div class="col-lg-4">
            <div class="sc-detail-section mb-4">
                <h6 class="fw-bold mb-2"><i class="bi bi-lightbulb me-2 text-warning"></i>Idea summary</h6>
                <p class="small text-muted mb-3">@Model.IdeaTagline</p>
                <ul class="list-unstyled small mb-3 sc-kv">
                    <li><span>Stage</span><strong>@Model.ProgressStage</strong></li>
                    <li><span>Funding goal</span><strong>₹@Model.MinimumFundRequired.ToString("N0")</strong></li>
                    <li><span>Team size</span><strong>@Model.Members.Count / @Model.ExpectedTeamSize</strong></li>
                    <li><span>Roadmap</span><strong>@Model.Roadmap.Percent% done</strong></li>
                </ul>
                @if (Model.RolesNeeded.Any())
                {
                    <div class="mb-3">
                        @foreach (var r in Model.RolesNeeded) { <span class="sc-role-tag">@r</span> }
                    </div>
                }
                @if (Model.IdeaStatus == IdeaStatus.Approved)
                {
                    <a asp-controller="Ideas" asp-action="Detail" asp-route-id="@Model.IdeaId" class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-box-arrow-up-right me-1"></i>Public idea page</a>
                }
            </div>

            <div class="sc-detail-section" id="team">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i>Team</h6>
                    <span class="badge bg-primary-subtle text-primary rounded-pill">@Model.Members.Count</span>
                </div>
                <ul class="list-unstyled mb-0">
                    @foreach (var m in Model.Members)
                    {
                        <li class="d-flex align-items-center gap-2 py-2 @(m != Model.Members.Last() ? "border-bottom" : "")">
                            <partial name="_Avatar" model="@(new AvatarModel(m.FullName, m.PhotoUrl, 38))" />
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-semibold small text-truncate">
                                    <a asp-controller="Profile" asp-action="Detail" asp-route-id="@m.UserId" class="text-dark">@m.FullName</a>
                                    @if (m.IsVerified) { <partial name="_VerifiedBadge" /> }
                                    @if (m.UserId == Model.CurrentUserId) { <span class="text-muted fw-normal">(you)</span> }
                                </div>
                                <div class="small @(m.IsFounder ? "text-warning-emphasis fw-semibold" : "text-muted") text-truncate">
                                    @if (m.IsFounder) { <i class="bi bi-star-fill me-1"></i> }@m.Role
                                </div>
                            </div>
                            @if (Model.IsFounder && !m.IsFounder)
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown" aria-label="Manage @m.FullName"><i class="bi bi-three-dots-vertical"></i></button>
                                    <div class="dropdown-menu dropdown-menu-end shadow-sm p-3" style="min-width:250px">
                                        <form asp-action="ChangeRole" method="post" class="mb-2">
                                            <input type="hidden" name="teamId" value="@Model.TeamId" />
                                            <input type="hidden" name="memberId" value="@m.MemberId" />
                                            <label class="form-label small fw-semibold mb-1" for="role-@m.MemberId">Role</label>
                                            <div class="input-group input-group-sm">
                                                <input type="text" id="role-@m.MemberId" name="role" class="form-control" value="@m.Role" maxlength="@TeamRoles.MaxLength" list="roleSuggestions" required />
                                                <button type="submit" class="btn btn-primary-sc">Save</button>
                                            </div>
                                        </form>
                                        <form asp-action="RemoveMember" method="post" onsubmit="return confirm('Remove @m.FullName from the team?');">
                                            <input type="hidden" name="teamId" value="@Model.TeamId" />
                                            <input type="hidden" name="memberId" value="@m.MemberId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-person-dash me-1"></i>Remove from team</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </li>
                    }
                </ul>
                @if (Model.IsFounder)
                {
                    <datalist id="roleSuggestions">
                        @foreach (var r in TeamRoles.Suggested) { <option value="@r"></option> }
                    </datalist>
                    <a asp-controller="Interests" asp-action="Manage" class="btn btn-sm btn-outline-secondary w-100 mt-3"><i class="bi bi-person-plus me-1"></i>Review join requests</a>
                }
            </div>
        </div>

        <!-- Milestones -->
        <div class="col-12" id="milestones">
            <div class="sc-detail-section mb-0">
                <h5 class="fw-bold mb-3"><i class="bi bi-signpost-2 me-2 text-success"></i>Milestones</h5>
                <div id="milestoneBoard">
                    <partial name="_MilestoneBoard" model="Model.Roadmap" view-data="ViewData" />
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create / edit milestone -->
<div class="modal fade" id="milestoneModal" tabindex="-1" aria-labelledby="milestoneModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" asp-action="CreateMilestone" id="milestoneForm"
              data-create-action="@Url.Action("CreateMilestone")" data-edit-action="@Url.Action("EditMilestone")">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="milestoneModalLabel">Add milestone</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="teamId" value="@Model.TeamId" />
                <input type="hidden" name="milestoneId" id="msId" value="" />
                <div class="mb-3">
                    <label for="msTitle" class="form-label fw-semibold">Title</label>
                    <input type="text" name="Title" id="msTitle" class="form-control" required maxlength="@TeamService.MaxMilestoneTitle" placeholder="e.g. Launch beta with 20 farmers" />
                </div>
                <div class="mb-3">
                    <label for="msDescription" class="form-label fw-semibold">Description <span class="text-muted small fw-normal">(optional)</span></label>
                    <textarea name="Description" id="msDescription" class="form-control" rows="3" maxlength="@TeamService.MaxMilestoneDescription" placeholder="What does done look like?"></textarea>
                </div>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label for="msDue" class="form-label fw-semibold">Due date</label>
                        <input type="date" name="DueDate" id="msDue" class="form-control" />
                    </div>
                    <div class="col-sm-6">
                        <label for="msAssignee" class="form-label fw-semibold">Assignee</label>
                        <select name="AssigneeUserId" id="msAssignee" class="form-select">
                            <option value="">Unassigned</option>
                            @foreach (var m in Model.Members)
                            {
                                <option value="@m.UserId">@m.FullName@(m.UserId == Model.CurrentUserId ? " (you)" : "")</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary-sc" id="msSubmit">Add milestone</button>
            </div>
        </form>
    </div>
</div>

<script type="application/json" id="workspaceData">@Json.Serialize(new { teamId = Model.TeamId, currentUserId = Model.CurrentUserId, messages = Model.Messages })</script>

@section Scripts {
    <script src="~/js/workspace.js" asp-append-version="true"></script>
}
