@{
    ViewData["Title"] = "Manage Requests";
    var incoming = (List<StartupConnect.Models.Interest>)ViewBag.Incoming;
    var outgoing = (List<StartupConnect.Models.Interest>)ViewBag.Outgoing;

    string GetBadgeClass(StartupConnect.Models.InterestStatus status) => status switch
    {
        StartupConnect.Models.InterestStatus.Pending => "bg-warning",
        StartupConnect.Models.InterestStatus.Accepted => "bg-success",
        StartupConnect.Models.InterestStatus.Rejected => "bg-danger",
        StartupConnect.Models.InterestStatus.Cancelled => "bg-secondary",
        _ => "bg-secondary"
    };
}

<div class="container py-5 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-inbox-fill text-primary me-2"></i>Collaboration Requests</h2>
    </div>

    <ul class="nav nav-pills mb-4" id="requestsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4" id="incoming-tab" data-bs-toggle="tab" data-bs-target="#incoming" type="button" role="tab">
                Incoming (@incoming.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 ms-2" id="outgoing-tab" data-bs-toggle="tab" data-bs-target="#outgoing" type="button" role="tab">
                Outgoing (@outgoing.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="requestsTabsContent">
        <!-- Incoming Requests Tab -->
        <div class="tab-pane fade show active" id="incoming" role="tabpanel">
            @if (incoming.Any())
            {
                <div class="row g-4">
                    @foreach (var req in incoming)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 shadow-sm border-0 p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h5 class="fw-bold mb-0">From: @req.User.FullName</h5>
                                    <span class="badge @GetBadgeClass(req.Status)">
                                        @req.Status
                                    </span>
                                </div>
                                <p class="mb-1 text-muted small"><i class="bi bi-calendar-event me-1"></i>Date: @req.CreatedAt.ToString("MMM dd, yyyy")</p>
                                <p class="mb-1 text-muted small">Idea: <a asp-controller="Ideas" asp-action="Detail" asp-route-id="@req.IdeaId" class="text-decoration-none fw-semibold">@req.Idea.Title</a></p>
                                <p class="mb-1 text-muted small">Type: <strong>@req.InterestType</strong></p>
                                @if (req.ProposedInvestmentAmount > 0)
                                {
                                    <p class="mb-1 text-muted small">Investment: <strong>₹@req.ProposedInvestmentAmount?.ToString("N0")</strong></p>
                                }
                                <p class="mb-4 text-muted small">Message: <em>@req.Message</em></p>

                                <div class="mt-auto d-flex flex-column gap-2">
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Profile" asp-action="Detail" asp-route-id="@req.UserId" class="btn btn-outline-primary w-100 rounded-pill">View Profile</a>
                                    </div>
                                    @if (req.Status == StartupConnect.Models.InterestStatus.Pending)
                                    {
                                        <div class="d-flex gap-2">
                                            <form asp-action="Accept" method="post" class="w-50">
                                                <input type="hidden" name="id" value="@req.Id" />
                                                <button class="btn btn-success w-100 rounded-pill">Accept</button>
                                            </form>
                                            <form asp-action="Reject" method="post" class="w-50">
                                                <input type="hidden" name="id" value="@req.Id" />
                                                <button class="btn btn-outline-danger w-100 rounded-pill">Reject</button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-light border text-center p-5 rounded-4">
                    <i class="bi bi-inbox fs-1 text-muted mb-3 d-block"></i>
                    <h5>No Incoming Requests</h5>
                    <p class="text-muted mb-0">You don't have any incoming collaboration or investment requests.</p>
                </div>
            }
        </div>

        <!-- Outgoing Requests Tab -->
        <div class="tab-pane fade" id="outgoing" role="tabpanel">
            @if (outgoing.Any())
            {
                <div class="row g-4">
                    @foreach (var req in outgoing)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 shadow-sm border-0 p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h5 class="fw-bold mb-0">Idea: @req.Idea.Title</h5>
                                    <span class="badge @GetBadgeClass(req.Status)">
                                        @req.Status
                                    </span>
                                </div>
                                <p class="mb-1 text-muted small"><i class="bi bi-calendar-event me-1"></i>Date: @req.CreatedAt.ToString("MMM dd, yyyy")</p>
                                <p class="mb-1 text-muted small">Owner: @req.Idea.Submitter.FullName</p>
                                <p class="mb-1 text-muted small">Type: <strong>@req.InterestType</strong></p>
                                <p class="mb-4 text-muted small">Message: <em>@req.Message</em></p>
                                
                                <div class="mt-auto d-flex flex-column gap-2">
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Ideas" asp-action="Detail" asp-route-id="@req.IdeaId" class="btn btn-outline-primary w-50 rounded-pill">View Idea</a>
                                        <a asp-controller="Profile" asp-action="Detail" asp-route-id="@req.Idea.SubmitterUserId" class="btn btn-outline-secondary w-50 rounded-pill">View Profile</a>
                                    </div>
                                    @if (req.Status == StartupConnect.Models.InterestStatus.Pending)
                                    {
                                        <div class="d-flex gap-2">
                                            <form asp-action="Cancel" method="post" class="w-100">
                                                <input type="hidden" name="id" value="@req.Id" />
                                                <button class="btn btn-outline-danger w-100 rounded-pill">Cancel Request</button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-light border text-center p-5 rounded-4">
                    <i class="bi bi-send fs-1 text-muted mb-3 d-block"></i>
                    <h5>No Outgoing Requests</h5>
                    <p class="text-muted mb-0">You haven't sent any collaboration or investment requests yet.</p>
                </div>
            }
        </div>
    </div>
</div>
