@using StartupConnect.Infrastructure
@using StartupConnect.Services.Matching
@{
    ViewData["Title"] = "Collaboration Requests";
    var incoming = (List<InterestRequestViewModel>)ViewBag.Incoming;
    var outgoing = (List<InterestRequestViewModel>)ViewBag.Outgoing;
    var states = ViewBag.ConnectionStates as Dictionary<string, ConnectionState> ?? new();
    var tab = (string)ViewBag.Tab;
    var pendingIncoming = incoming.Count(r => r.Status == InterestStatus.Pending);

    string BadgeClass(InterestStatus status) => status switch
    {
        InterestStatus.Pending => "bg-warning-subtle text-warning-emphasis",
        InterestStatus.Accepted => "bg-success-subtle text-success-emphasis",
        InterestStatus.Rejected => "bg-danger-subtle text-danger-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
    string StatusLabel(InterestStatus status) => status == InterestStatus.Rejected ? "Declined" : status.ToString();
    string TypeLabel(InterestType t) => t switch
    {
        InterestType.Work => "Wants to join the team",
        InterestType.Invest => "Wants to invest",
        _ => "Wants to join & invest"
    };
    string TypeIcon(InterestType t) => t switch { InterestType.Work => "bi-person-plus", InterestType.Invest => "bi-cash-coin", _ => "bi-stars" };
}

<div class="container py-5 mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-inbox-fill text-primary me-2"></i>Collaboration Requests</h2>
            <p class="text-muted mb-0">People who want to work on or invest in your ideas — and requests you've sent.</p>
        </div>
    </div>

    <ul class="nav sc-tabs gap-2 mb-4" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(tab == "incoming" ? "active" : "")" id="incoming-tab" data-bs-toggle="tab" data-bs-target="#incoming" type="button" role="tab" aria-controls="incoming" aria-selected="@(tab == "incoming" ? "true" : "false")">
                Incoming <span class="badge rounded-pill sc-tab-count ms-1">@incoming.Count</span>
                @if (pendingIncoming > 0) { <span class="badge rounded-pill bg-warning text-dark ms-1" title="Awaiting your reply">@pendingIncoming new</span> }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(tab == "outgoing" ? "active" : "")" id="outgoing-tab" data-bs-toggle="tab" data-bs-target="#outgoing" type="button" role="tab" aria-controls="outgoing" aria-selected="@(tab == "outgoing" ? "true" : "false")">
                Sent <span class="badge rounded-pill sc-tab-count ms-1">@outgoing.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Incoming -->
        <div class="tab-pane fade @(tab == "incoming" ? "show active" : "")" id="incoming" role="tabpanel" aria-labelledby="incoming-tab">
            @if (incoming.Any())
            {
                <div class="row g-4">
                    @foreach (var req in incoming)
                    {
                        <div class="col-lg-6">
                            <div class="card h-100 shadow-sm border-0 rounded-4 sc-interest-card" id="request-@req.Id">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                        <div class="small text-muted min-w-0">
                                            <i class="bi @TypeIcon(req.InterestType) me-1"></i>@TypeLabel(req.InterestType) ·
                                            <a asp-controller="Ideas" asp-action="Detail" asp-route-id="@req.IdeaId" class="fw-semibold text-decoration-none">@req.IdeaTitle</a>
                                        </div>
                                        <span class="badge rounded-pill @BadgeClass(req.Status) flex-shrink-0">@StatusLabel(req.Status)</span>
                                    </div>

                                    <!-- Sender mini profile -->
                                    <div class="d-flex gap-3 mb-3">
                                        <partial name="_Avatar" model="@(new AvatarModel(req.OtherName, req.OtherPhotoUrl, 56))" />
                                        <div class="min-w-0 flex-grow-1">
                                            <h5 class="fw-bold mb-0">
                                                @if (req.CanViewProfile)
                                                {
                                                    <a asp-controller="Profile" asp-action="Detail" asp-route-id="@req.OtherUserId" class="text-decoration-none text-dark">@req.OtherName</a>
                                                }
                                                else
                                                {
                                                    @req.OtherName
                                                }
                                                @if (req.OtherVerified) { <partial name="_VerifiedBadge" /> }
                                            </h5>
                                            <div class="sc-interest-meta">
                                                @(req.OtherIsInvestor ? "Investor" : "Founder")
                                                @if (req.OtherAvailability.HasValue) { <text> · @TeamMatchScorer.AvailabilityLabel(req.OtherAvailability.Value)@(req.OtherHoursPerWeek > 0 ? $" ({req.OtherHoursPerWeek}h/wk)" : "")</text> }
                                                @if (req.OtherLocation != null) { <text> · <i class="bi bi-geo-alt"></i> @req.OtherLocation</text> }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(req.OtherBio))
                                            {
                                                <p class="small text-muted mb-1 mt-1 sc-clamp-2">@req.OtherBio</p>
                                            }
                                            @if (req.OtherSkills.Any())
                                            {
                                                <div class="mt-1">
                                                    @foreach (var skill in req.OtherSkills.Take(6)) { <span class="sc-role-tag">@skill</span> }
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Request details -->
                                    <div class="d-flex flex-wrap gap-3 small mb-2">
                                        @if (req.SelectedRoles.Any())
                                        {
                                            <span><i class="bi bi-briefcase text-primary me-1"></i>Role@(req.SelectedRoles.Count == 1 ? "" : "s"): <strong>@string.Join(", ", req.SelectedRoles)</strong></span>
                                        }
                                        @if (req.ProposedInvestmentAmount > 0)
                                        {
                                            <span><i class="bi bi-cash-coin text-success me-1"></i>Offers <strong>₹@req.ProposedInvestmentAmount.Value.ToString("N0")</strong></span>
                                        }
                                        <span class="text-muted"><i class="bi bi-clock me-1"></i>@AppTime.Ago(req.CreatedAt, DateTime.UtcNow)</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(req.Message))
                                    {
                                        <div class="sc-interest-message mb-3">@req.Message</div>
                                    }
                                    else
                                    {
                                        <p class="small text-muted fst-italic mb-3">No message included.</p>
                                    }

                                    @if (req.Status == InterestStatus.Pending)
                                    {
                                        <form method="post" class="mt-auto" asp-action="Accept">
                                            <input type="hidden" name="id" value="@req.Id" />
                                            <label class="form-label small fw-semibold" for="note-@req.Id">Reply note <span class="text-muted fw-normal">(optional — sent to @req.OtherName)</span></label>
                                            <textarea id="note-@req.Id" name="note" class="form-control form-control-sm mb-2" rows="2" maxlength="@Interest.MaxResponseNoteLength" placeholder="e.g. Great fit! Let's do a call this week."></textarea>
                                            <div class="d-flex flex-wrap gap-2">
                                                <button type="submit" class="btn btn-success rounded-pill flex-grow-1"><i class="bi bi-check-lg me-1"></i>Accept</button>
                                                <button type="submit" asp-action="Reject" class="btn btn-outline-danger rounded-pill flex-grow-1"><i class="bi bi-x-lg me-1"></i>Decline</button>
                                            </div>
                                        </form>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(req.ResponseNote))
                                    {
                                        <div class="sc-reply-note mb-3"><span class="fw-semibold d-block small text-muted">Your reply@(req.RespondedAt.HasValue ? " · " + AppTime.Ago(req.RespondedAt.Value, DateTime.UtcNow) : "")</span>@req.ResponseNote</div>
                                    }

                                    <div class="d-flex flex-wrap gap-2 mt-3 @(req.Status == InterestStatus.Pending ? "" : "mt-auto")">
                                        @if (req.CanViewProfile)
                                        {
                                            <a asp-controller="Profile" asp-action="Detail" asp-route-id="@req.OtherUserId" class="btn btn-outline-primary btn-sm rounded-pill flex-grow-1"><i class="bi bi-person me-1"></i>View profile</a>
                                        }
                                        <partial name="_ConnectButton" model="@(new ConnectButtonModel(req.OtherUserId, states.GetValueOrDefault(req.OtherUserId), req.OtherName))" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="sc-empty-state">
                    <div class="sc-empty-icon"><i class="bi bi-inbox"></i></div>
                    <h5>No incoming requests yet</h5>
                    <p class="text-muted">When someone wants to join or invest in one of your ideas, they'll show up here with their profile so you can decide.</p>
                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <a asp-controller="Matches" asp-action="FindTeam" class="btn btn-primary-sc rounded-pill">Find teammates</a>
                        <a asp-controller="Ideas" asp-action="MyIdeas" class="btn btn-outline-secondary rounded-pill">My ideas</a>
                    </div>
                </div>
            }
        </div>

        <!-- Sent -->
        <div class="tab-pane fade @(tab == "outgoing" ? "show active" : "")" id="outgoing" role="tabpanel" aria-labelledby="outgoing-tab">
            @if (outgoing.Any())
            {
                <div class="row g-4">
                    @foreach (var req in outgoing)
                    {
                        <div class="col-lg-6">
                            <div class="card h-100 shadow-sm border-0 rounded-4 sc-interest-card">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <h5 class="fw-bold mb-0 min-w-0"><a asp-controller="Ideas" asp-action="Detail" asp-route-id="@req.IdeaId" class="text-decoration-none text-dark">@req.IdeaTitle</a></h5>
                                        <span class="badge rounded-pill @BadgeClass(req.Status) flex-shrink-0">@StatusLabel(req.Status)</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <partial name="_Avatar" model="@(new AvatarModel(req.OtherName, req.OtherPhotoUrl, 28))" />
                                        <span class="small">Founder: <strong>@req.OtherName</strong> @if (req.OtherVerified) { <partial name="_VerifiedBadge" /> }</span>
                                    </div>
                                    <div class="d-flex flex-wrap gap-3 small text-muted mb-2">
                                        <span><i class="bi @TypeIcon(req.InterestType) me-1"></i>@TypeLabel(req.InterestType)</span>
                                        @if (req.SelectedRoles.Any()) { <span><i class="bi bi-briefcase me-1"></i>@string.Join(", ", req.SelectedRoles)</span> }
                                        @if (req.ProposedInvestmentAmount > 0) { <span><i class="bi bi-cash-coin me-1"></i>₹@req.ProposedInvestmentAmount.Value.ToString("N0")</span> }
                                        <span><i class="bi bi-clock me-1"></i>@AppTime.Ago(req.CreatedAt, DateTime.UtcNow)</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(req.Message))
                                    {
                                        <div class="sc-interest-message mb-3">@req.Message</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(req.ResponseNote))
                                    {
                                        <div class="sc-reply-note mb-3"><span class="fw-semibold d-block small text-muted">Reply from @req.OtherName</span>@req.ResponseNote</div>
                                    }

                                    <div class="mt-auto d-flex flex-wrap gap-2">
                                        <a asp-controller="Ideas" asp-action="Detail" asp-route-id="@req.IdeaId" class="btn btn-outline-primary btn-sm rounded-pill flex-grow-1">View idea</a>
                                        @if (req.CanViewProfile)
                                        {
                                            <a asp-controller="Profile" asp-action="Detail" asp-route-id="@req.OtherUserId" class="btn btn-outline-secondary btn-sm rounded-pill flex-grow-1">Founder profile</a>
                                        }
                                        @if (req.Status == InterestStatus.Pending)
                                        {
                                            <form asp-action="Cancel" method="post" class="flex-grow-1">
                                                <input type="hidden" name="id" value="@req.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill w-100">Cancel request</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="sc-empty-state">
                    <div class="sc-empty-icon"><i class="bi bi-send"></i></div>
                    <h5>You haven't sent any requests</h5>
                    <p class="text-muted">Find an idea you believe in and offer to work on it, invest, or both.</p>
                    <a asp-controller="Ideas" asp-action="Browse" class="btn btn-primary-sc rounded-pill">Explore ideas</a>
                </div>
            }
        </div>
    </div>
</div>
