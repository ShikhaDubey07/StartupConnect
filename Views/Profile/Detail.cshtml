@model StartupConnect.ViewModels.ProfileViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = Model.FullName + " - Profile";
    var profileUserId = ViewBag.ProfileUserId as string ?? "";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isOwnProfile = !string.IsNullOrEmpty(currentUserId) && currentUserId == profileUserId;
    var categoryNames = ViewBag.CategoryNames as List<string> ?? new List<string>();
    var userIdeas = ViewBag.UserIdeas as List<StartupConnect.Models.Idea> ?? new List<StartupConnect.Models.Idea>();
    var shownEmail = ViewBag.ShownEmail as string;
    var connectionState = ViewBag.ConnectionState as ConnectionState? ?? ConnectionState.None;
    var previewMode = ViewBag.PreviewMode as string;
    var hint = ViewBag.PrivacyHint as ProfilePrivacyHint;
    var location = string.Join(", ", new[] { Model.City, Model.State }.Where(v => !string.IsNullOrWhiteSpace(v)));
    string VisibilityLabel(string v) => v switch
    {
        ProfileVisibilityOptions.Private => "Private — only you, admins, your connections and teammates",
        ProfileVisibilityOptions.RegisteredUsers => "Members only — anyone signed in to StartupConnect",
        _ => "Public — anyone, including visitors who aren't signed in"
    };
}

<section class="sc-page-header">
    <div class="container">
        <h1>@Model.FullName's Profile</h1>
        <p class="opacity-75 mb-0">Learn more about this user's skills and interests</p>
    </div>
</section>

<div class="container pb-5 mt-4">
    @if (hint != null)
    {
        <div class="sc-privacy-hint p-3 mb-4 d-flex flex-wrap align-items-center gap-3">
            <i class="bi @(hint.IsPreview ? "bi-eye" : "bi-shield-lock") fs-4 text-primary"></i>
            <div class="flex-grow-1 min-w-0">
                @if (hint.IsPreview)
                {
                    <div class="fw-semibold">Preview: this is how @(previewMode == "public" ? "signed-out visitors" : "other signed-in members") see your profile.</div>
                }
                else
                {
                    <div class="fw-semibold">This is your profile. Visibility: @VisibilityLabel(hint.Visibility).</div>
                }
                <div class="small text-muted">
                    Email @(hint.ShowEmail ? "shown" : "hidden") · Location @(hint.ShowLocation ? "shown" : "hidden") · Age @(hint.ShowAge ? "shown" : "hidden") to others.
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (hint.IsPreview)
                {
                    <a asp-action="Detail" asp-route-id="@profileUserId" class="btn btn-sm btn-primary rounded-pill">Exit preview</a>
                }
                else
                {
                    <a asp-action="Detail" asp-route-id="@profileUserId" asp-route-preview="public" class="btn btn-sm btn-outline-primary rounded-pill"><i class="bi bi-eye me-1"></i>Preview as public</a>
                    <a asp-action="Detail" asp-route-id="@profileUserId" asp-route-preview="member" class="btn btn-sm btn-outline-primary rounded-pill">Preview as a member</a>
                }
                <a asp-controller="Settings" asp-action="Index" asp-route-tab="privacy" class="btn btn-sm btn-outline-secondary rounded-pill"><i class="bi bi-sliders me-1"></i>Privacy settings</a>
            </div>
        </div>
    }
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="sc-form-card text-center">
                <div class="d-inline-block mb-3"><partial name="_Avatar" model="@(new AvatarModel(Model.FullName, ViewBag.PhotoUrl as string, 100))" /></div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                @if (ViewBag.IsVerifiedFounder == true)
                {
                    <div class="mb-2"><partial name="_VerifiedBadge" model="@("lg")" /></div>
                }
                @if (location.Length > 0)
                {
                    <p class="text-muted mb-2"><i class="bi bi-geo-alt me-1"></i> @location</p>
                }
                @if (Model.Age.HasValue)
                {
                    <p class="text-muted mb-2"><i class="bi bi-person me-1"></i> @Model.Age years old</p>
                }
                @if (!string.IsNullOrEmpty(shownEmail))
                {
                    <p class="mb-2"><a href="mailto:@shownEmail" class="text-muted text-decoration-none"><i class="bi bi-envelope me-1"></i>@shownEmail</a></p>
                }
                
                @if (Model.IsInvestor)
                {
                    <span class="badge bg-success-subtle text-success fs-6 mb-3">Investor</span>
                }
                else
                {
                    <span class="badge bg-primary-subtle text-primary fs-6 mb-3">Founder / Contributor</span>
                }
                
                <div class="d-flex justify-content-center gap-3 mt-3">
                    @if (StartupConnect.Infrastructure.UrlSafety.IsSafeHttpUrl(Model.LinkedInUrl))
                    {
                        <a href="@Model.LinkedInUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm rounded-circle" style="width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    }
                    @if (StartupConnect.Infrastructure.UrlSafety.IsSafeHttpUrl(Model.PortfolioUrl))
                    {
                        <a href="@Model.PortfolioUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm rounded-circle" style="width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center" title="Portfolio"><i class="bi bi-link-45deg"></i></a>
                    }
                </div>

                @if (previewMode == "member")
                {
                    <div class="mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-primary-sc rounded-pill w-100 py-2" disabled><i class="bi bi-person-plus-fill me-1"></i>Connect</button>
                        <div class="small text-muted mt-2">Members see a Connect button here.</div>
                    </div>
                }
                else if (!isOwnProfile && User.Identity?.IsAuthenticated == true)
                {
                    <div class="mt-4 pt-3 border-top">
                        <partial name="_ConnectButton" model="@(new ConnectButtonModel(profileUserId, connectionState, Model.FullName, "profile"))" />
                        @if (ViewBag.ViaRelationship == true)
                        {
                            <div class="small text-muted mt-2"><i class="bi bi-lock me-1"></i>This profile is private — you can see it because you're connected or on a team together.</div>
                        }
                    </div>
                }
                else if (User.Identity?.IsAuthenticated != true || previewMode == "public")
                {
                    <div class="mt-4 pt-3 border-top">
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"/Profile/Detail/{profileUserId}")" class="btn btn-primary-sc rounded-pill w-100 py-2">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Sign in to connect
                        </a>
                    </div>
                }
                else if (isOwnProfile && previewMode == null)
                {
                    <div class="mt-4 pt-3 border-top">
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary rounded-pill w-100 py-2">
                            <i class="bi bi-pencil me-1"></i> Edit My Profile
                        </a>
                    </div>
                }
            </div>
        </div>
        
        <div class="col-lg-8">
            <div class="sc-form-card mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">About</h5>
                <p class="text-muted">
                    @(string.IsNullOrWhiteSpace(Model.Bio) ? "This user hasn't added a bio yet." : Model.Bio)
                </p>

                <div class="row g-4 mt-2">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-dark"><i class="bi bi-clock me-2"></i>Availability</h6>
                        <p class="text-muted mb-0">@Model.TimeAvailability (@Model.HoursPerWeek hrs/week)</p>
                    </div>
                    @if (Model.IsInvestor)
                    {
                        <div class="col-md-6">
                            <h6 class="fw-bold text-dark"><i class="bi bi-cash me-2"></i>Investment Capacity</h6>
                            <p class="text-muted mb-0">@StartupConnect.Services.InvestorDashboardService.CapacityLabel(Model.InvestmentCapacity)</p>
                        </div>
                    }
                </div>
                
                <h5 class="fw-bold mb-3 mt-4 border-bottom pb-2">Skills</h5>
                @if (Model.SelectedSkills != null && Model.SelectedSkills.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var skill in Model.SelectedSkills)
                        {
                            <span class="badge bg-white text-dark border p-2"><i class="bi bi-check2 me-1 text-primary"></i>@skill</span>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small">No skills listed.</p>
                }

                <h5 class="fw-bold mb-3 mt-4 border-bottom pb-2">Areas of Interest</h5>
                @if (categoryNames.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var cat in categoryNames)
                        {
                            <span class="badge bg-primary bg-opacity-10 text-primary border p-2"><i class="bi bi-tag me-1"></i>@cat</span>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small">No interest categories selected.</p>
                }
            </div>

            @if (userIdeas.Any())
            {
                <div class="sc-form-card">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Startup Ideas by @Model.FullName</h5>
                    <div class="row g-3">
                        @foreach (var idea in userIdeas)
                        {
                            <div class="col-md-6">
                                <div class="card h-100 border shadow-sm rounded-3 sc-hover-card">
                                    <div class="card-body p-3 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span class="badge bg-white text-dark border">@idea.Category.Name</span>
                                            <span class="text-muted small"><i class="bi bi-heart-fill text-danger me-1"></i>@(idea.Likes?.Count ?? 0)</span>
                                        </div>
                                        <h6 class="fw-bold mb-1 text-dark">@idea.Title</h6>
                                        <p class="text-muted small mb-3 text-truncate">@idea.Tagline</p>
                                        <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                                            <span class="text-success small fw-bold">₹@idea.MinimumFundRequired.ToString("N0")</span>
                                            <a asp-controller="Ideas" asp-action="Detail" asp-route-id="@idea.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">View Idea</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
