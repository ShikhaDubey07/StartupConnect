@{
    ViewData["Title"] = "Founder Analytics";
    // In a real implementation, we'd pass a viewmodel with these stats
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold mb-1">Founder Analytics & Insights</h2>
            <p class="text-muted mb-0">Track your startup ideas' performance and engagement.</p>
        </div>
        <div>
            <a asp-controller="Ideas" asp-action="Submit" class="btn btn-primary rounded-pill px-4">New Idea</a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card sc-idea-card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-eye text-primary fs-1 mb-2"></i>
                <h3 class="fw-bold mb-0">1,245</h3>
                <p class="text-muted small mb-0">Total Views</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card sc-idea-card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-heart text-danger fs-1 mb-2"></i>
                <h3 class="fw-bold mb-0">89</h3>
                <p class="text-muted small mb-0">Total Likes</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card sc-idea-card border-0 shadow-sm h-100 text-center p-4">
                <i class="bi bi-chat-dots text-info fs-1 mb-2"></i>
                <h3 class="fw-bold mb-0">34</h3>
                <p class="text-muted small mb-0">Total Comments</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card sc-idea-card border-0 shadow-sm h-100 text-center p-4 bg-primary text-black">
                <i class="bi bi-fire fs-1 mb-2"></i>
                <h3 class="fw-bold mb-0">2,030</h3>
                <p class="text-black-50 small mb-0">Avg Engagement Score</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Activity Timeline -->
        <div class="col-lg-8">
            <div class="card sc-idea-card border-0 shadow-sm">
                <div class="card-header bg-transparent border-bottom p-4">
                    <h5 class="fw-bold mb-0">Recent Activity Timeline</h5>
                </div>
                <div class="card-body p-4">
                    <div class="timeline position-relative ps-4 border-start border-2 border-primary border-opacity-25">
                        <!-- Static mock data for UI demo -->
                        <div class="timeline-item mb-4 position-relative">
                            <span class="position-absolute start-0 translate-middle p-2 bg-primary border border-white border-3 rounded-circle" style="left: -24px !important;"></span>
                            <div class="text-muted small mb-1">Today, 2:30 PM</div>
                            <h6 class="fw-bold mb-1">New Investor Interest</h6>
                            <p class="text-muted small">An investor has shown interest in your idea "EcoDeliver".</p>
                        </div>
                        <div class="timeline-item mb-4 position-relative">
                            <span class="position-absolute start-0 translate-middle p-2 bg-success border border-white border-3 rounded-circle" style="left: -24px !important;"></span>
                            <div class="text-muted small mb-1">Yesterday, 10:15 AM</div>
                            <h6 class="fw-bold mb-1">Milestone Completed</h6>
                            <p class="text-muted small">You completed the milestone "Finish MVP design" in Workspace.</p>
                        </div>
                        <div class="timeline-item mb-4 position-relative">
                            <span class="position-absolute start-0 translate-middle p-2 bg-info border border-white border-3 rounded-circle" style="left: -24px !important;"></span>
                            <div class="text-muted small mb-1">Oct 12, 4:00 PM</div>
                            <h6 class="fw-bold mb-1">Submitted to Challenge</h6>
                            <p class="text-muted small">You submitted "EcoDeliver" to the GreenTech Innovation Challenge.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Trending Ideas list for Founder -->
        <div class="col-lg-4">
            <div class="card sc-idea-card border-0 shadow-sm">
                <div class="card-header bg-transparent border-bottom p-4">
                    <h5 class="fw-bold mb-0">Top Performing Ideas</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                        <div>
                            <h6 class="fw-bold mb-0">EcoDeliver</h6>
                            <small class="text-muted">1,200 views</small>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success">High Engagement</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="fw-bold mb-0">SmartWallet</h6>
                            <small class="text-muted">45 views</small>
                        </div>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary">Drafting</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
