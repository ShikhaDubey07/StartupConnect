@model FounderAnalyticsViewModel
@using StartupConnect.Infrastructure
@using StartupConnect.Services
@using StartupConnect.Models
@{
    ViewData["Title"] = "Founder Analytics";
    var now = DateTime.UtcNow;
    var maxScore = Model.Ideas.Any() ? Math.Max(1, Model.Ideas.Max(i => i.Score)) : 1;
}

<section class="sc-page-header">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1><i class="bi bi-graph-up me-2"></i>Founder Analytics</h1>
            <p class="opacity-75 mb-0">How your ideas are performing, and everything you've been up to.</p>
        </div>
        <a asp-controller="Ideas" asp-action="Submit" class="btn btn-accent"><i class="bi bi-plus-lg me-1"></i>New idea</a>
    </div>
</section>

<div class="container pb-5">
    <div class="row g-4 mb-5">
        <div class="col-6 col-md-3">
            <div class="sc-dash-stat text-center h-100">
                <i class="bi bi-eye text-primary fs-2"></i>
                <div class="stat-value">@Model.TotalViews.ToString("N0")</div>
                <div class="text-muted small fw-bold text-uppercase">Total views</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="sc-dash-stat text-center h-100">
                <i class="bi bi-heart text-danger fs-2"></i>
                <div class="stat-value">@Model.TotalLikes.ToString("N0")</div>
                <div class="text-muted small fw-bold text-uppercase">Total likes</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="sc-dash-stat text-center h-100">
                <i class="bi bi-chat-dots text-info fs-2"></i>
                <div class="stat-value">@Model.TotalComments.ToString("N0")</div>
                <div class="text-muted small fw-bold text-uppercase">Total comments</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="sc-dash-stat text-center h-100">
                <i class="bi bi-fire text-warning fs-2"></i>
                <div class="stat-value">@Model.AverageEngagement.ToString("N1")</div>
                <div class="text-muted small fw-bold text-uppercase">Avg engagement / idea</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="sc-detail-section h-100 mb-0">
                <h5 class="fw-bold mb-4"><i class="bi bi-clock-history me-2 text-primary"></i>Recent activity</h5>
                @if (!Model.Activities.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-activity fs-2 d-block mb-2"></i>
                        <p class="mb-3">Your activity will show up here — submitting ideas, joining teams, completing milestones and entering challenges.</p>
                        <a asp-controller="Challenges" asp-action="Index" class="btn btn-sm btn-outline-primary">Browse challenges</a>
                    </div>
                }
                else
                {
                    <ul class="sc-timeline list-unstyled mb-0">
                        @foreach (var a in Model.Activities)
                        {
                            var (icon, color) = ActivityTypes.Style(a.ActionType);
                            var link = UrlSafety.IsLocalPath(a.RelatedUrl) ? a.RelatedUrl : null;
                            <li>
                                <span class="sc-timeline-dot bg-@color"><i class="bi @icon"></i></span>
                                <div class="small text-muted mb-1" title="@AppTime.FormatIst(a.CreatedAt)">@AppTime.Ago(a.CreatedAt, now)</div>
                                <h6 class="fw-bold mb-1">@a.ActionType</h6>
                                <p class="text-muted small mb-0">
                                    @a.Description
                                    @if (link != null) { <a href="@link" class="ms-1">View <i class="bi bi-arrow-right-short"></i></a> }
                                </p>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="sc-detail-section mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-bar-chart me-2 text-success"></i>Top performing ideas</h5>
                @if (!Model.Ideas.Any())
                {
                    <div class="text-center text-muted py-3">
                        <p class="mb-3">You haven't submitted an idea yet.</p>
                        <a asp-controller="Ideas" asp-action="Submit" class="btn btn-sm btn-accent">Submit your first idea</a>
                    </div>
                }
                else
                {
                    foreach (var i in Model.Ideas.Take(6))
                    {
                        var width = (int)Math.Round(100.0 * i.Score / maxScore);
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                @if (i.Status == IdeaStatus.Approved)
                                {
                                    <a asp-controller="Ideas" asp-action="Analytics" asp-route-id="@i.IdeaId" class="fw-semibold text-dark text-truncate">@i.Title</a>
                                }
                                else
                                {
                                    <span class="fw-semibold text-truncate">@i.Title</span>
                                }
                                <span class="badge badge-@i.Status.ToString().ToLowerInvariant() flex-shrink-0">@i.Status</span>
                            </div>
                            <div class="progress my-1" style="height:6px"><div class="progress-bar bg-success" style="width:@width%"></div></div>
                            <div class="small text-muted">
                                <i class="bi bi-eye me-1"></i>@i.Views · <i class="bi bi-heart ms-1 me-1"></i>@i.Likes · <i class="bi bi-chat ms-1 me-1"></i>@i.Comments · <i class="bi bi-people ms-1 me-1"></i>@i.Interests interested
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="row g-3">
                <div class="col-6">
                    <div class="sc-mini-stat"><span>@Model.MilestonesCompleted</span>Milestones completed</div>
                </div>
                <div class="col-6">
                    <div class="sc-mini-stat"><span>@Model.ChallengeEntries</span>Challenge entries</div>
                </div>
            </div>
        </div>
    </div>
</div>
