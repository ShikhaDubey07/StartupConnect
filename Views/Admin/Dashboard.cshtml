@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="sc-admin-dashboard pt-4 pb-5">
    <div class="container">
        <!-- Dashboard Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 fade-in-up">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1"><i class="bi bi-shield-lock text-primary me-2"></i>Admin Dashboard</h1>
                <p class="text-muted mb-0">Manage ideas, users, and platform activity</p>
            </div>
            <div>
                <span class="badge bg-white text-dark border px-3 py-2 shadow-sm"><i class="bi bi-clock me-1"></i> @DateTime.Now.ToString("MMM dd, yyyy")</span>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="row g-4 mb-5 fade-in-up delay-1">
            <div class="col-sm-6 col-xl-3">
                <a href="@Url.Action("Users", "Admin")" class="text-decoration-none">
                    <div class="sc-admin-stat-card primary">
                        <div class="sc-admin-stat-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div class="sc-admin-stat-value">@Model.TotalUsers</div>
                        <div class="sc-admin-stat-label">Total Users</div>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a href="@Url.Action("Ideas", "Admin")" class="text-decoration-none">
                    <div class="sc-admin-stat-card info">
                        <div class="sc-admin-stat-icon">
                            <i class="bi bi-lightbulb-fill"></i>
                        </div>
                        <div class="sc-admin-stat-value">@Model.TotalIdeas</div>
                        <div class="sc-admin-stat-label">Total Ideas</div>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a href="@Url.Action("Ideas", "Admin", new { status = StartupConnect.Models.IdeaStatus.Submitted })" class="text-decoration-none">
                    <div class="sc-admin-stat-card warning">
                        <div class="sc-admin-stat-icon">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <div class="sc-admin-stat-value">@Model.PendingIdeas</div>
                        <div class="sc-admin-stat-label">Pending Review</div>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a href="@Url.Action("Ideas", "Admin", new { status = StartupConnect.Models.IdeaStatus.Approved })" class="text-decoration-none">
                    <div class="sc-admin-stat-card success">
                        <div class="sc-admin-stat-icon">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        <div class="sc-admin-stat-value">@Model.ApprovedIdeas</div>
                        <div class="sc-admin-stat-label">Approved</div>
                    </div>
                </a>
            </div>
        </div>

        <!-- Pending Ideas Section -->
        <div class="fade-in-up delay-2">
            <h3 class="sc-admin-section-title">
                <i class="bi bi-inbox-fill text-primary"></i> Pending Idea Verifications
                <span class="badge bg-primary rounded-pill ms-2 fs-6 px-3">@Model.PendingIdeas</span>
            </h3>

            @if (Model.PendingIdeasList.Any())
            {
                <div class="row g-4">
                    @foreach (var idea in Model.PendingIdeasList)
                    {
                        <div class="col-md-6 col-xl-4">
                            <!-- Clickable Card -->
                            <div class="sc-admin-idea-card" data-bs-toggle="modal" data-bs-target="#ideaModal-@idea.Id">
                                <div class="sc-admin-idea-header">
                                    <span class="badge bg-white text-dark border"><i class="bi bi-tag-fill text-primary me-1"></i> @idea.Category.Name</span>
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i> Pending</span>
                                </div>
                                <div class="sc-admin-idea-body">
                                    <h5 class="sc-admin-idea-title text-truncate" title="@idea.Title">@idea.Title</h5>
                                    <p class="sc-admin-idea-tagline text-truncate" title="@idea.Tagline">@idea.Tagline</p>
                                    
                                    <div class="d-flex justify-content-between align-items-center mt-4">
                                        <div class="text-success fw-bold">
                                            <i class="bi bi-cash"></i> ₹@idea.MinimumFundRequired.ToString("N0")
                                        </div>
                                        <div class="text-muted small">
                                            <i class="bi bi-person-circle me-1"></i> @idea.Submitter.FullName
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-white rounded-4 border shadow-sm mx-auto mt-4" style="max-width: 600px;">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                        <i class="bi bi-check2-all fs-1"></i>
                    </div>
                    <h4 class="fw-bold mb-2 text-dark">Inbox Zero!</h4>
                    <p class="text-muted mb-0 fs-5">There are currently no ideas pending your review. Great job!</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODALS - Placed outside of any positioning contexts -->
@if (Model.PendingIdeasList.Any())
{
    @foreach (var idea in Model.PendingIdeasList)
    {
        <!-- Modal for Idea Details -->
        <div class="modal fade" id="ideaModal-@idea.Id" tabindex="-1" aria-labelledby="ideaModalLabel-@idea.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content sc-admin-modal-content">
                    <div class="modal-header sc-admin-modal-header">
                        <div>
                            <h4 class="modal-title fw-bold text-dark mb-1" id="ideaModalLabel-@idea.Id">@idea.Title</h4>
                            <div class="text-muted small"><i class="bi bi-person me-1"></i> Submitted by @idea.Submitter.FullName</div>
                        </div>
                        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body sc-admin-modal-body">
                        <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill">
                                <i class="bi bi-tag me-1"></i> @idea.Category.Name
                            </span>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                                <i class="bi bi-cash me-1"></i> ₹@idea.MinimumFundRequired.ToString("N0") Required
                            </span>
                        </div>
                        
                        <h6 class="fw-bold text-uppercase text-muted small mb-2" style="letter-spacing: 0.05em;">Tagline</h6>
                        <p class="fs-5 mb-4 text-dark border-start border-4 border-primary ps-3">"@idea.Tagline"</p>

                        <h6 class="fw-bold text-uppercase text-muted small mb-2" style="letter-spacing: 0.05em;">Full Description</h6>
                        <div class="bg-white border p-4 rounded-3 mb-4 text-secondary" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6;">@idea.Description</div>
                        
                        @if (idea.RolesNeeded != null && idea.RolesNeeded.Any())
                        {
                            <h6 class="fw-bold text-uppercase text-muted small mb-2" style="letter-spacing: 0.05em;">Roles Needed</h6>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                @foreach (var role in idea.RolesNeeded)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-2 rounded-pill">@role.RoleName</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="modal-footer sc-admin-modal-footer d-block">
                        <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-shield-check text-primary me-2"></i>Admin Decision</h6>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <form asp-action="Approve" method="post" class="w-100">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@idea.Id" />
                                    <button type="submit" class="btn btn-success w-100 py-2 fw-semibold shadow-sm rounded-3">
                                        <i class="bi bi-check-circle-fill me-2"></i>Approve & Publish
                                    </button>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <form asp-action="Reject" method="post" class="w-100">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@idea.Id" />
                                    <div class="input-group shadow-sm rounded-3">
                                        <input type="text" name="reason" class="form-control py-2 border-end-0" placeholder="Rejection reason..." required />
                                        <button type="submit" class="btn btn-danger py-2 px-3 fw-semibold">
                                            <i class="bi bi-x-circle-fill"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
