@model IEnumerable<StartupConnect.Models.IdeaReport>
@{
    ViewData["Title"] = "Reports & Safety";
    Layout = "_Layout";
}

<div class="sc-admin-dashboard pt-4 pb-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1"><i class="bi bi-flag-fill text-danger me-2"></i>Reports & Safety</h1>
                <p class="text-muted mb-0">Manage user reports and flagged content</p>
            </div>
            <a asp-action="Dashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back to Dashboard</a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3 px-4">Date</th>
                            <th class="py-3">Reported By</th>
                            <th class="py-3">Reason</th>
                            <th class="py-3">Idea</th>
                            <th class="py-3 text-end px-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var report in Model.OrderByDescending(r => r.CreatedAt))
                            {
                                <tr>
                                    <td class="px-4 text-muted small">@report.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <div class="fw-bold">@report.User.FullName</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">@report.Reason</span>
                                    </td>
                                    <td>
                                        <a asp-controller="Ideas" asp-action="Detail" asp-route-id="@report.IdeaId" class="text-decoration-none" target="_blank">
                                            @report.Idea.Title <i class="bi bi-box-arrow-up-right small ms-1"></i>
                                        </a>
                                    </td>
                                    <td class="text-end px-4">
                                        <a asp-controller="Ideas" asp-action="Detail" asp-route-id="@report.IdeaId" class="btn btn-sm btn-outline-primary" target="_blank">Review</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-shield-check display-4 mb-3 d-block text-success opacity-50"></i>
                                    No reports found. The platform is safe!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
