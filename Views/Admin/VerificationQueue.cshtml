@model AdminVerificationViewModel
@using StartupConnect.Infrastructure
@using StartupConnect.Models
@{
    ViewData["Title"] = "Founder Verification";
    var now = DateTime.UtcNow;
}

<div class="sc-admin-dashboard pt-4 pb-5">
    <div class="container">
        @await Component.InvokeAsync("AdminNav", new { active = "Verification" })

        <div class="mb-4">
            <h1 class="h3 fw-bold text-dark mb-1"><i class="bi bi-patch-check-fill text-primary me-2"></i>Founder verification</h1>
            <p class="text-muted mb-0">Review requests for the Verified Founder badge. Check the applicant's LinkedIn and ideas before approving.</p>
        </div>

        <h3 class="sc-admin-section-title">
            <i class="bi bi-hourglass-split text-warning"></i> Pending
            <span class="badge bg-primary rounded-pill ms-1 fs-6 px-3">@Model.Pending.Count</span>
        </h3>

        @if (!Model.Pending.Any())
        {
            <div class="sc-empty-state bg-white rounded-4 border shadow-sm mb-5">
                <div class="sc-empty-icon text-success"><i class="bi bi-check2-all"></i></div>
                <h5>All caught up</h5>
                <p class="text-muted mb-0">There are no verification requests waiting for review.</p>
            </div>
        }
        else
        {
            <div class="row g-4 mb-5">
                @foreach (var r in Model.Pending)
                {
                    var ideas = Model.ApprovedIdeaCounts.GetValueOrDefault(r.UserId);
                    var linkedIn = UrlSafety.IsSafeHttpUrl(r.LinkedInUrl) ? r.LinkedInUrl : null;
                    <div class="col-lg-6">
                        <div class="sc-form-card h-100 d-flex flex-column">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <partial name="_Avatar" model="@(new AvatarModel(r.User.FullName, r.User.Profile?.ProfilePhotoUrl, 52))" />
                                <div class="min-w-0">
                                    <h5 class="fw-bold mb-0 text-truncate">@r.User.FullName</h5>
                                    <div class="small text-muted text-truncate">@r.User.Email · @(r.User.City ?? "Location not set")</div>
                                    <div class="small text-muted">Requested @AppTime.Ago(r.CreatedAt, now) · member since @AppTime.ToIst(r.User.CreatedAt).ToString("MMM yyyy")</div>
                                </div>
                            </div>
                            <div class="sc-pitch small mb-3" style="white-space: pre-line"><i class="bi bi-chat-quote me-1"></i>@r.Note</div>
                            <div class="d-flex flex-wrap gap-2 small mb-3">
                                @if (linkedIn != null)
                                {
                                    <a href="@linkedIn" target="_blank" rel="noopener noreferrer nofollow" class="btn btn-sm btn-outline-primary"><i class="bi bi-linkedin me-1"></i>LinkedIn</a>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary align-self-center">No LinkedIn provided</span>
                                }
                                <a asp-controller="Profile" asp-action="Detail" asp-route-id="@r.UserId" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-person me-1"></i>Profile</a>
                                <span class="badge @(ideas > 0 ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning-emphasis") align-self-center">
                                    <i class="bi bi-lightbulb me-1"></i>@ideas approved idea@(ideas == 1 ? "" : "s")
                                </span>
                                <span class="badge bg-light text-dark border align-self-center">Profile @(r.User.Profile?.ProfileCompletionPercent ?? 0)% complete</span>
                            </div>
                            <div class="row g-2 mt-auto">
                                <div class="col-sm-4">
                                    <form asp-action="ApproveVerification" method="post">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-success w-100"><i class="bi bi-check-circle me-1"></i>Approve</button>
                                    </form>
                                </div>
                                <div class="col-sm-8">
                                    <form asp-action="RejectVerification" method="post">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <div class="input-group">
                                            <input type="text" name="reason" class="form-control" placeholder="Reason for rejection…" required maxlength="500" aria-label="Rejection reason" />
                                            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle me-1"></i>Reject</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <h3 class="sc-admin-section-title"><i class="bi bi-clock-history text-secondary"></i> Recent decisions</h3>
        @if (!Model.RecentDecisions.Any())
        {
            <p class="text-muted">Approved and rejected requests will be listed here.</p>
        }
        else
        {
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr><th class="px-4">Founder</th><th>Decision</th><th>Reviewed</th><th class="px-4">Notes</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.RecentDecisions)
                            {
                                <tr>
                                    <td class="px-4"><a asp-controller="Profile" asp-action="Detail" asp-route-id="@r.UserId" class="text-dark fw-semibold">@r.User.FullName</a></td>
                                    <td>
                                        @if (r.Status == VerificationRequestStatus.Approved)
                                        {
                                            <span class="badge bg-success-subtle text-success"><i class="bi bi-patch-check-fill me-1"></i>Approved</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Rejected</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@(r.ReviewedAt.HasValue ? AppTime.Ago(r.ReviewedAt.Value, now) : "")@(r.ReviewedBy != null ? $" by {r.ReviewedBy.FullName}" : "")</td>
                                    <td class="px-4 small text-muted" style="min-width:220px">@(r.RejectionReason ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
