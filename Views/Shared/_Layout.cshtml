@using Microsoft.AspNetCore.Identity
@using StartupConnect.Models
@using StartupConnect.Data
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ApplicationUser? layoutUser = null;
    UserProfile? layoutProfile = null;
    var pendingConnections = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var layoutUserId = UserManager.GetUserId(User);
        if (layoutUserId != null)
        {
            layoutUser = await DbContext.Users.FindAsync(layoutUserId);
            layoutProfile = await DbContext.UserProfiles.AsNoTracking().FirstOrDefaultAsync(p => p.UserId == layoutUserId);
            pendingConnections = await DbContext.Connections.CountAsync(c => c.AddresseeId == layoutUserId && c.Status == ConnectionStatus.Pending && c.Requester.IsActive);
        }
    }
    var isInvestorUser = layoutProfile?.IsInvestor == true || User.IsInRole("Investor");
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - StartupConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- AOS Animation CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light sc-navbar fixed-top">
        <div class="container">
            <a class="navbar-brand sc-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-rocket-takeoff"></i></span>
                StartupConnect
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Ideas" asp-action="Browse">Explore Ideas</a></li>
                    @if (isInvestorUser)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Investor" asp-action="Dashboard"><i class="bi bi-graph-up-arrow me-1 text-cashmere"></i>Investor Hub</a></li>
                    }
                    <li class="nav-item"><a class="nav-link" asp-controller="Challenges" asp-action="Index"><i class="bi bi-trophy me-1 text-cashmere"></i>Challenges</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Videos" asp-action="Index"><i class="bi bi-play-circle me-1 text-cashmere"></i>Videos</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="HowItWorks">How It Works</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var userId = UserManager.GetUserId(User);
                        ApplicationUser? currentUser = null;
                        UserProfile? currentProfile = null;
                        UserSettings? currentSettings = null;
                        if (userId != null)
                        {
                            currentUser = layoutUser;
                            currentProfile = layoutProfile;
                            currentSettings = await DbContext.UserSettings.FirstOrDefaultAsync(s => s.UserId == userId);
                        }
                        var fullName = currentUser?.FullName ?? User.Identity.Name;
                        var photoUrl = currentProfile?.ProfilePhotoUrl;
                        var participationType = currentProfile != null && currentProfile.IsInvestor ? "Investor" : "Founder";
                        var theme = currentSettings?.ThemePreference ?? "Light";

                        <script>
                            (function() {
                                var theme = "Light";
                                if (theme === "Dark") {
                                    
                                } else if (theme === "System") {
                                    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                                        
                                    }
                                }
                            })();
                        </script>

                        <li class="nav-item dropdown me-2">
                            <a class="nav-link position-relative" href="#" id="notifDropdown" data-bs-toggle="dropdown">
                                <i class="bi bi-bell fs-5"></i>
                                <span class="notif-badge d-none" id="notifCount">0</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end notif-dropdown shadow-lg" id="notifList">
                                <li><span class="dropdown-item-text text-muted small">No new notifications</span></li>
                            </ul>
                        </li>
                        
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (!string.IsNullOrEmpty(photoUrl))
                                {
                                    <img src="@photoUrl" alt="Profile" class="rounded-circle object-fit-cover shadow-sm border border-light" width="36" height="36" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-primary text-black d-flex align-items-center justify-content-center fw-bold shadow-sm border border-light" style="width: 36px; height: 36px; font-size: 15px;">
                                        @(string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 py-2 mt-2 dropdown-profile" aria-labelledby="profileDropdown">
                                <li class="px-3 py-2 border-bottom mb-2">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(photoUrl))
                                        {
                                            <img src="@photoUrl" alt="Profile" class="rounded-circle object-fit-cover shadow-sm" width="48" height="48" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-primary text-black d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 48px; height: 48px; font-size: 20px;">
                                                @(string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper())
                                            </div>
                                        }
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark text-truncate" style="max-width: 150px;">@fullName</h6>
                                            <span class="badge bg-gradient-subtle text-primary border mt-1" style="background: linear-gradient(135deg, rgba(99,102,241,0.1), rgba(139,92,246,0.1)); border-color: rgba(99,102,241,0.2) !important;">@participationType</span>
                                        </div>
                                    </div>
                                </li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Account" asp-action="Dashboard"><i class="bi bi-speedometer2 text-muted"></i> Dashboard</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person text-muted"></i> Profile</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Ideas" asp-action="MyIdeas"><i class="bi bi-lightbulb text-muted"></i> My Ideas</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Network" asp-action="Index"><i class="bi bi-diagram-3 text-muted"></i> My Network
                                    @if (pendingConnections > 0) { <span class="badge rounded-pill bg-danger ms-auto" title="Pending connection requests">@pendingConnections</span> }</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Workspace" asp-action="Index"><i class="bi bi-kanban text-muted"></i> My Teams</a></li>
                                @if (isInvestorUser)
                                {
                                    <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Investor" asp-action="Dashboard"><i class="bi bi-graph-up-arrow text-muted"></i> Investor Dashboard</a></li>
                                }
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Analytics"><i class="bi bi-graph-up text-muted"></i> Founder Analytics</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Matches" asp-action="Index"><i class="bi bi-people text-muted"></i> Smart Matches</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Matches" asp-action="FindTeam"><i class="bi bi-search text-muted"></i> Find Co-founder & Team</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Ideas" asp-action="Matches"><i class="bi bi-diagram-3 text-muted"></i> Similar Ideas</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Interests" asp-action="Manage"><i class="bi bi-briefcase text-muted"></i> Collaboration Requests</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Notifications" asp-action="Index"><i class="bi bi-app-indicator text-muted"></i> Notifications</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Ideas" asp-action="Saved"><i class="bi bi-bookmark text-muted"></i> Saved Ideas</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Videos" asp-action="Index"><i class="bi bi-play-circle text-muted"></i> Startup Videos</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear text-muted"></i> Settings</a></li>
                                <li><a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Help" asp-action="Index"><i class="bi bi-question-circle text-muted"></i> Help & Support</a></li>
                                @if (User.IsInRole("Admin") || User.IsInRole("Panel"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 d-flex align-items-center gap-2 text-cashmere fw-semibold" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-shield-lock"></i> Admin Dashboard</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger w-100 text-start border-0 bg-transparent"><i class="bi bi-box-arrow-right"></i> Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="nav-item">
                            <a class="btn btn-copper btn-sm px-4 ms-lg-2" asp-controller="Account" asp-action="Register">Get Started</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
            <div class="toast show sc-toast-success" role="alert">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                </div>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
            <div class="toast show sc-toast-error" role="alert">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
                </div>
            </div>
        </div>
    }

    <main class="sc-main">
        @if (layoutUser != null && !layoutUser.EmailConfirmed && ViewData["HideConfirmBanner"] as bool? != true)
        {
            <div class="sc-confirm-banner py-2" role="status">
                <div class="container d-flex flex-wrap align-items-center gap-2">
                    <i class="bi bi-envelope-exclamation fs-5"></i>
                    <span>Please confirm your email (<strong>@layoutUser.Email</strong>) to submit ideas and connect with teams.</span>
                    <form asp-controller="Account" asp-action="ResendConfirmation" method="post" class="d-inline ms-md-auto">
                        <input type="hidden" name="Email" value="@layoutUser.Email" />
                        <button type="submit" class="btn btn-link btn-sm">Resend confirmation email</button>
                    </form>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="sc-footer text-white">
        <div class="container">
            <div class="row g-4 py-5">
                <div class="col-lg-4">
                    <h5 class="sc-footer-brand d-flex align-items-center gap-2 text-white"><span class="brand-icon" style="width:32px;height:32px;font-size:0.9rem;"><i class="bi bi-rocket-takeoff"></i></span>StartupConnect</h5>
                    <p class="text-white mt-3" style="line-height:1.7">Connecting India's youth to build startups together. Don't start alone — find your team, get funded, and launch.</p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center text-white" style="width:36px;height:36px;background:rgba(0,0,0,0.08);border:1px solid rgba(0,0,0,0.1);" title="Twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center text-white" style="width:36px;height:36px;background:rgba(0,0,0,0.08);border:1px solid rgba(0,0,0,0.1);" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center text-white" style="width:36px;height:36px;background:rgba(0,0,0,0.08);border:1px solid rgba(0,0,0,0.1);" title="Instagram"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="text-white mb-3 fw-bold" style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.08em;">Platform</h6>
                    <ul class="list-unstyled sc-footer-links">
                        <li><a asp-controller="Ideas" asp-action="Browse" class="text-white">Explore Ideas</a></li>
                        <li><a asp-controller="Challenges" asp-action="Index" class="text-white">Startup Challenges</a></li>
                        <li><a asp-controller="Videos" asp-action="Index" class="text-white">Startup Videos</a></li>
                        <li><a asp-controller="Account" asp-action="Register" class="text-white">Join Now</a></li>
                        <li><a asp-controller="Home" asp-action="HowItWorks" class="text-white">How It Works</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="text-white mb-3 fw-bold" style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.08em;">Support</h6>
                    <ul class="list-unstyled sc-footer-links">
                        <li><a asp-controller="Home" asp-action="Contact" class="text-white">Contact Us</a></li>
                        <li><a asp-controller="Help" asp-action="Index" class="text-white">Help Center</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy" class="text-white">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="text-white mb-3 fw-bold" style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.08em;">Built for Indian Youth 🇮🇳</h6>
                    <p class="text-white small" style="line-height:1.7">Empowering the next generation of entrepreneurs across every city and village in India.</p>
                    <div class="d-flex align-items-center gap-2 mt-3">
                        <span class="badge rounded-pill px-3 py-2 text-white" style="background:rgba(99,102,241,0.2);border:1px solid rgba(99,102,241,0.3);"><i class="bi bi-shield-check me-1"></i>Verified Platform</span>
                        <span class="badge rounded-pill px-3 py-2 text-white" style="background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);"><i class="bi bi-lightning-charge me-1"></i>Free Forever</span>
                    </div>
                </div>
            </div>
            <div class="border-top border-white-10 py-3 d-flex flex-wrap justify-content-between align-items-center text-white small">
                <span>&copy; @DateTime.Now.Year StartupConnect. All rights reserved.</span>
                <span class="d-flex align-items-center gap-1">Made with <i class="bi bi-heart-fill text-white" style="font-size:0.7rem"></i> in India</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/microsoft-signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/connections.js" asp-append-version="true"></script>
    }
    <!-- AOS Animation JS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        if (window.AOS) AOS.init({
            duration: 800,
            once: true,
            offset: 50
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
