@model ResendConfirmationViewModel
@{
    ViewData["HideConfirmBanner"] = true;
    ViewData["Title"] = "Resend confirmation email";
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5">
                    @if (Model.Sent)
                    {
                        <div class="text-center">
                            <i class="bi bi-send-check display-4 text-success d-block mb-3"></i>
                            <h3 class="fw-bold">Check your inbox</h3>
                            <p class="text-muted mb-4">
                                If <strong class="text-dark">@Model.Email</strong> belongs to an account that still needs confirming,
                                a new confirmation link is on its way. It's valid for 24 hours.
                            </p>
                            <div class="d-grid gap-2">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <a asp-action="Dashboard" class="btn btn-primary rounded-pill py-2 fw-semibold">Back to dashboard</a>
                                }
                                else
                                {
                                    <a asp-action="Login" class="btn btn-primary rounded-pill py-2 fw-semibold">Back to log in</a>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center mb-4">
                            <i class="bi bi-envelope-arrow-up display-4 text-primary d-block mb-3"></i>
                            <h3 class="fw-bold">Resend confirmation email</h3>
                            <p class="text-muted">Enter the email you registered with and we'll send you a new confirmation link.</p>
                        </div>
                        <form asp-action="ResendConfirmation" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
                            <div class="mb-4">
                                <label asp-for="Email" class="form-label fw-medium">Email address</label>
                                <input asp-for="Email" class="form-control" placeholder="you@email.com" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary rounded-pill py-2 fw-semibold">Send confirmation link</button>
                                <a asp-action="Login" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold">Back to log in</a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
