@model ConfirmEmailResultViewModel
@{
    ViewData["Title"] = Model.Succeeded ? "Email confirmed" : "Confirmation link problem";
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5 text-center">
                    @if (Model.Succeeded)
                    {
                        <i class="bi bi-patch-check-fill display-4 text-success d-block mb-3"></i>
                        <h3 class="fw-bold">@(Model.AlreadyConfirmed ? "You're already confirmed" : "Email confirmed!")</h3>
                        <p class="text-muted mb-4">
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <span><strong class="text-dark">@Model.Email</strong> is verified. </span>
                            }
                            You can now submit ideas, show interest and connect with founders and investors.
                        </p>
                        <div class="d-grid gap-2">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-controller="Ideas" asp-action="Submit" class="btn btn-primary rounded-pill py-2 fw-semibold"><i class="bi bi-lightbulb me-1"></i>Submit your first idea</a>
                                <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold">Go to dashboard</a>
                            }
                            else
                            {
                                <a asp-action="Login" class="btn btn-primary rounded-pill py-2 fw-semibold">Log in</a>
                            }
                        </div>
                    }
                    else
                    {
                        <i class="bi bi-envelope-x display-4 text-warning d-block mb-3"></i>
                        <h3 class="fw-bold">This link didn't work</h3>
                        <p class="text-muted mb-4">
                            The confirmation link is invalid or has expired (links are valid for 24 hours).
                            No worries — we can send you a fresh one.
                        </p>
                        <div class="d-grid gap-2">
                            <a asp-action="ResendConfirmation" class="btn btn-primary rounded-pill py-2 fw-semibold">Send a new confirmation link</a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold">Back to home</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
