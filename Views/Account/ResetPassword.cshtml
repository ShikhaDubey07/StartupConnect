@model ResetPasswordViewModel
@{
    ViewData["HideConfirmBanner"] = true;
    ViewData["Title"] = "Choose a new password";
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5">
                    @if (Model.LinkInvalid)
                    {
                        <div class="text-center">
                            <i class="bi bi-hourglass-bottom display-4 text-warning d-block mb-3"></i>
                            <h3 class="fw-bold">This reset link has expired</h3>
                            <p class="text-muted mb-4">
                                Password reset links are valid for a limited time and can only be used once.
                                If you've already changed your password, just sign in — otherwise request a fresh link.
                            </p>
                            <div class="d-grid gap-2">
                                <a asp-action="ForgotPassword" class="btn btn-primary rounded-pill py-2 fw-semibold"><i class="bi bi-send me-1"></i>Send me a new link</a>
                                <a asp-action="Login" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold">Back to log in</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center mb-4">
                            <i class="bi bi-shield-lock display-4 text-primary d-block mb-3"></i>
                            <h3 class="fw-bold">Choose a new password</h3>
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <p class="text-muted mb-0">for <strong class="text-dark">@Model.Email</strong></p>
                            }
                        </div>
                        <form asp-action="ResetPassword" method="post" id="resetForm">
                            <input type="hidden" asp-for="UserId" />
                            <input type="hidden" asp-for="Code" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-medium"></label>
                                <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus aria-describedby="pwRules" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                                <ul class="list-unstyled small mt-2 mb-0 sc-pw-rules" id="pwRules">
                                    <li data-rule="len"><i class="bi bi-circle me-1"></i>At least 8 characters</li>
                                    <li data-rule="upper"><i class="bi bi-circle me-1"></i>An uppercase letter</li>
                                    <li data-rule="lower"><i class="bi bi-circle me-1"></i>A lowercase letter</li>
                                    <li data-rule="digit"><i class="bi bi-circle me-1"></i>A number</li>
                                    <li data-rule="symbol"><i class="bi bi-circle me-1"></i>A symbol (e.g. # ! @@ $)</li>
                                </ul>
                            </div>
                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label fw-medium"></label>
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary rounded-pill py-2 fw-semibold">Update password</button>
                            </div>
                            <p class="text-muted small text-center mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>For your security, other signed-in devices will be signed out.</p>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var input = document.getElementById('Password');
            if (!input) return;
            var rules = {
                len: function (v) { return v.length >= 8; },
                upper: function (v) { return /[A-Z]/.test(v); },
                lower: function (v) { return /[a-z]/.test(v); },
                digit: function (v) { return /\d/.test(v); },
                symbol: function (v) { return /[^a-zA-Z\d]/.test(v); }
            };
            function update() {
                document.querySelectorAll('#pwRules li').forEach(function (li) {
                    var ok = rules[li.dataset.rule](input.value);
                    li.classList.toggle('text-success', ok);
                    li.classList.toggle('text-muted', !ok);
                    var icon = li.querySelector('i');
                    icon.className = 'bi me-1 ' + (ok ? 'bi-check-circle-fill' : 'bi-circle');
                });
            }
            input.addEventListener('input', update);
            update();
        })();
    </script>
}
