@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Log into StartupConnect";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StartupConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #000;
        }
        .form-control:focus {
            box-shadow: none;
            border-color: #000 !important;
        }
        .border-bottom-only {
            border: 0;
            border-bottom: 1px solid #ccc !important;
            border-radius: 0;
            padding-left: 0;
            padding-right: 0;
            padding-bottom: 8px;
        }
        .border-bottom-only:focus {
            border-bottom: 1px solid #000 !important;
        }
        .login-btn {
            background-color: #f1f1f1;
            color: #a0a0a0;
            border: none;
            font-weight: 600;
            padding: 12px;
            letter-spacing: 0.5px;
            transition: all 0.2s;
        }
        .login-btn.active {
            background-color: #000;
            color: #000;
        }
        .login-btn.active:hover {
            background-color: #333;
        }
        .social-btn {
            border: 1px solid #000;
            border-radius: 0;
            background: #000;
            color: #000;
            font-weight: 500;
            padding: 12px;
            position: relative;
            transition: background 0.2s;
        }
        .social-btn:hover {
            background: #f8f8f8;
        }
        .social-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1.2rem;
        }
        .divider {
            position: relative;
            text-align: center;
        }
        .divider::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            border-top: 1px solid #e0e0e0;
            z-index: 1;
        }
        .divider span {
            background-color: #000;
            padding: 0 10px;
            color: #888;
            font-size: 0.75rem;
            position: relative;
            z-index: 2;
        }
        @@media (min-width: 768px) {
            .divider::before {
                top: 0;
                bottom: 0;
                left: 50%;
                border-top: none;
                border-left: 1px solid #e0e0e0;
                right: auto;
            }
            .divider span {
                padding: 10px 0;
                display: inline-block;
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
            }
        }
        .back-link {
            transition: opacity 0.2s;
            opacity: 0.6;
        }
        .back-link:hover {
            opacity: 1;
        }
    </style>
</head>
<body class="min-vh-100 d-flex flex-column position-relative">

    <!-- Back Button -->
    <div class="position-absolute top-0 start-0 p-4 z-3">
        <a asp-controller="Home" asp-action="Index" class="text-dark text-decoration-none fw-semibold d-inline-flex align-items-center back-link">
            <i class="bi bi-arrow-left fs-5 me-2"></i> Back
        </a>
    </div>

    <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center px-4 py-5" data-aos="zoom-in" data-aos-duration="600">
        
        <div class="mb-3">
            <i class="bi bi-layers-fill fs-2" style="display: inline-block;"></i>
        </div>

        <h2 class="fw-bold mb-5 pb-3">Log into StartupConnect</h2>

        <div class="row w-100 justify-content-center" style="max-width: 500px;">
            <div class="col-12 mb-5 mb-md-0">
                <form asp-action="Login" method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Email Address</label>
                        <input asp-for="Email" class="form-control border-bottom-only" placeholder="name@example.com" value="" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 position-relative">
                        <label asp-for="Password" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Password</label>
                        <input asp-for="Password" class="form-control border-bottom-only pe-4" placeholder="Password" />
                        <i class="bi bi-eye position-absolute cursor-pointer text-muted" id="togglePassword" style="right: 0; bottom: 8px; cursor: pointer;"></i>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-none">
                        <input asp-for="RememberMe" class="form-check-input" checked />
                    </div>

                    <button type="submit" class="btn login-btn w-100 mt-2" id="loginBtn">
                        LOG IN
                    </button>
                </form>
            </div>
        </div>
        
        <div class="mt-4 pt-4 text-center d-flex flex-column gap-3">
            <a asp-action="ForgotPassword" class="text-dark text-decoration-none fw-bold" style="font-size: 0.8rem;">CAN'T LOG IN?</a>
            <a asp-action="Register" class="text-dark text-decoration-none fw-bold" style="font-size: 0.8rem;">NEW USER? REGISTER HERE</a>
        </div>
        
        <!-- <div class="text-center small text-muted mt-5 pt-4">
            <strong>Demo Admin:</strong> admin@startupconnect.in / Admin@123<br>
            <strong>Demo User:</strong> rahul@demo.in / Demo@123
        </div> -->
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        $(document).ready(function() {
            $('#togglePassword').click(function() {
                var input = $('#Password');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    $(this).removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    input.attr('type', 'password');
                    $(this).removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });

            function checkInputs() {
                var email = $('#Email').val() || '';
                var pwd = $('#Password').val() || '';
                if (email.trim().length > 0 && pwd.trim().length > 0) {
                    $('#loginBtn').addClass('active');
                } else {
                    $('#loginBtn').removeClass('active');
                }
            }

            $('#Email, #Password').on('input', checkInputs);
            checkInputs();

            $('#loginForm').on('submit', function(e) {
                var btn = $('#loginBtn');
                if (!btn.attr('data-loading') && $(this).valid()) {
                    e.preventDefault();
                    btn.attr('data-loading', 'true');
                    btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>');
                    setTimeout(() => { this.submit(); }, 300);
                }
            });
        });
    </script>
</body>
</html>
