@using StartupConnect.ViewModels
@model ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StartupConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --sc-bg: #F5F2EC;
            --sc-card-bg: #FFFCF8;
            --sc-text-main: #29232F;
            --sc-text-muted: #716B76;
            --sc-border-beige: #E2DDD5;
            --sc-purple: #603B78;
            --sc-purple-hover: #4D2D63;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--sc-bg);
            color: var(--sc-text-main);
            min-height: 100vh;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Outfit', 'Inter', sans-serif;
            color: var(--sc-text-main);
        }

        .sc-form-card {
            background-color: var(--sc-card-bg);
            border-radius: 16px;
            border: 1px solid var(--sc-border-beige);
            box-shadow: 0 4px 24px rgba(41, 35, 47, 0.05), 0 1px 3px rgba(41, 35, 47, 0.02);
            padding: 2.5rem;
        }

        @@media (max-width: 576px) {
            .sc-form-card {
                padding: 2rem 1.25rem;
            }
        }

        .form-label {
            color: var(--sc-text-muted) !important;
            font-weight: 600;
            font-size: 0.72rem;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: 0.4rem;
        }

        .form-control {
            background-color: #FFFFFF !important;
            border: 1.5px solid var(--sc-border-beige) !important;
            border-radius: 10px !important;
            padding: 0.65rem 1rem !important;
            color: var(--sc-text-main) !important;
            font-size: 0.95rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .form-control::placeholder {
            color: #A39D98;
        }

        .form-control:focus {
            background-color: #FFFFFF !important;
            border-color: var(--sc-purple) !important;
            box-shadow: 0 0 0 3px rgba(96, 59, 120, 0.15) !important;
            color: var(--sc-text-main) !important;
        }

        .login-btn {
            background-color: var(--sc-purple) !important;
            color: #FFFFFF !important;
            border: none !important;
            border-radius: 10px;
            font-weight: 600;
            padding: 12px;
            letter-spacing: 0.5px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px rgba(96, 59, 120, 0.25);
        }

        .login-btn:hover {
            background-color: var(--sc-purple-hover) !important;
            color: #FFFFFF !important;
            box-shadow: 0 6px 20px rgba(96, 59, 120, 0.35);
            transform: translateY(-1px);
        }

        .login-btn:active {
            transform: translateY(0);
        }

        .brand-icon-box {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: rgba(96, 59, 120, 0.1);
            color: var(--sc-purple);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .back-link {
            color: var(--sc-text-main) !important;
            transition: all 0.2s ease;
            opacity: 0.75;
        }

        .back-link:hover {
            color: var(--sc-purple) !important;
            opacity: 1;
        }

        .auth-link {
            color: var(--sc-text-main);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .auth-link:hover {
            color: var(--sc-purple);
        }
    </style>
</head>
<body class="min-vh-100 d-flex flex-column position-relative">

    <!-- Back Button -->
    <div class="position-absolute top-0 start-0 p-4 z-3">
        <a asp-controller="Account" asp-action="Login" class="back-link text-decoration-none fw-semibold d-inline-flex align-items-center">
            <i class="bi bi-arrow-left fs-5 me-2"></i> Back to Login
        </a>
    </div>

    <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center px-3 py-5">
        <div class="sc-form-card w-100" style="max-width: 460px;">
            <div class="text-center mb-4">
                <div class="brand-icon-box mb-3">
                    <i class="bi bi-key-fill"></i>
                </div>
                <h2 class="fw-bold mb-1" style="font-size: 1.65rem;">Forgot your password?</h2>
                <p class="text-muted small mb-0">Enter your email address and we'll send you a link to reset your password.</p>
            </div>

            <form asp-action="ForgotPassword" method="post" id="forgotPasswordForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn login-btn w-100 mt-2" id="submitBtn">
                    SEND RESET LINK
                </button>
            </form>

            <div class="mt-4 pt-3 border-top text-center" style="border-color: var(--sc-border-beige) !important;">
                <a asp-action="Login" class="auth-link fw-bold" style="font-size: 0.8rem;">REMEMBER YOUR PASSWORD? LOG IN</a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
            $('#forgotPasswordForm').on('submit', function(e) {
                var btn = $('#submitBtn');
                if (!btn.attr('data-loading') && $(this).valid()) {
                    e.preventDefault();
                    btn.attr('data-loading', 'true');
                    btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Sending...');
                    setTimeout(() => { this.submit(); }, 300);
                }
            });
        });
    </script>
</body>
</html>
