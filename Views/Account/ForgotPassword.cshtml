@using StartupConnect.ViewModels
@model ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StartupConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #000;
        }
        .form-control:focus {
            box-shadow: none;
            border-color: #000 !important;
        }
        .border-bottom-only {
            border: 0;
            border-bottom: 1px solid #ccc !important;
            border-radius: 0;
            padding-left: 0;
            padding-right: 0;
            padding-bottom: 8px;
        }
        .border-bottom-only:focus {
            border-bottom: 1px solid #000 !important;
        }
        .login-btn {
            background-color: #000;
            color: #000;
            border: none;
            font-weight: 600;
            padding: 12px;
            letter-spacing: 0.5px;
            transition: all 0.2s;
        }
        .login-btn:hover {
            background-color: #333;
        }
    </style>
</head>
<body class="min-vh-100 d-flex flex-column">
    <div class="d-flex justify-content-between align-items-center p-4">
        <a asp-controller="Account" asp-action="Login" class="text-dark text-decoration-none fw-bold" style="font-size: 0.85rem;">
            <i class="bi bi-chevron-left me-1" style="font-weight:bold;"></i> BACK TO LOGIN
        </a>
    </div>

    <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center px-4" style="margin-top: -60px;">
        <div class="mb-3">
            <i class="bi bi-key fs-2" style="display: inline-block;"></i>
        </div>
        <h2 class="fw-bold mb-3">Forgot your password?</h2>
        <p class="text-muted mb-5 text-center" style="max-width: 400px;">Enter your email address and we'll send you a link to reset your password.</p>

        <div class="row w-100 justify-content-center" style="max-width: 500px;">
            <div class="col-12">
                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Email Address</label>
                        <input asp-for="Email" class="form-control border-bottom-only" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn login-btn w-100 mt-2">
                        SEND RESET LINK
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
