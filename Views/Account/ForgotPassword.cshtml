@model ForgotPasswordViewModel
@{
    ViewData["HideConfirmBanner"] = true;
    ViewData["Title"] = "Forgot password";
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-key display-4 text-primary d-block mb-3"></i>
                        <h3 class="fw-bold">Forgot your password?</h3>
                        <p class="text-muted mb-0">Enter the email you signed up with and we'll send you a link to choose a new password.</p>
                    </div>
                    <form asp-action="ForgotPassword" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-medium">Email address</label>
                            <input asp-for="Email" class="form-control" placeholder="you@email.com" autocomplete="email" autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill py-2 fw-semibold"><i class="bi bi-send me-1"></i>Send reset link</button>
                            <a asp-action="Login" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold">Back to log in</a>
                        </div>
                    </form>
                    <p class="text-muted small text-center mt-4 mb-0">
                        Remembered it but locked out after too many attempts? Resetting your password also unlocks your account.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
