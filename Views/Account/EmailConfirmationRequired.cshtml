@{
    ViewData["HideConfirmBanner"] = true;
    ViewData["Title"] = "Confirm your email to continue";
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5 text-center">
                    <i class="bi bi-shield-lock display-4 text-primary d-block mb-3"></i>
                    <h3 class="fw-bold">One quick step first</h3>
                    <p class="text-muted mb-4">
                        To keep StartupConnect free of spam, submitting ideas and reaching out to founders needs a confirmed email.
                        We sent a link to <strong class="text-dark">@ViewBag.Email</strong> when you signed up.
                    </p>
                    <div class="d-grid gap-2">
                        <form asp-action="ResendConfirmation" method="post">
                            <input type="hidden" name="Email" value="@ViewBag.Email" />
                            <button type="submit" class="btn btn-primary rounded-pill py-2 fw-semibold w-100">
                                <i class="bi bi-envelope me-1"></i>Email me a new link
                            </button>
                        </form>
                        <a asp-controller="Ideas" asp-action="Browse" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold">Keep exploring ideas</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
