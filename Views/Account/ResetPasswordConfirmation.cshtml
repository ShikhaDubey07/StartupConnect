@{
    ViewData["HideConfirmBanner"] = true;
    ViewData["Title"] = "Password updated";
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5 text-center">
                    <i class="bi bi-check-circle-fill display-4 text-success d-block mb-3"></i>
                    <h3 class="fw-bold">Your password has been reset</h3>
                    <p class="text-muted mb-4">You can now sign in with your new password. We've also emailed you a confirmation, and any other signed-in devices will be signed out shortly.</p>
                    <div class="d-grid">
                        <a asp-action="Login" class="btn btn-primary rounded-pill py-2 fw-semibold"><i class="bi bi-box-arrow-in-right me-1"></i>Sign in</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
