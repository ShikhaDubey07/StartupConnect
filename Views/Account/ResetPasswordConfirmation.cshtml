@{
    ViewData["Title"] = "Password Reset Successful";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5" style="max-width: 480px;">
    <div class="card shadow-sm border-0 rounded-3 text-center">
        <div class="card-body p-4">
            <div class="mb-3" style="font-size: 3rem;">✅</div>
            <h4 class="fw-bold mb-2">Password Reset Successful!</h4>
            <p class="text-muted mb-4">Your password has been updated. You can now log in with your new password.</p>
            <a asp-action="Login" asp-controller="Account" class="btn btn-primary px-4">
                Go to Login
            </a>
        </div>
    </div>
</div>
