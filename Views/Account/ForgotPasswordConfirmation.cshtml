@{
    Layout = null;
    ViewData["Title"] = "Forgot Password Confirmation";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StartupConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #000;
        }
    </style>
</head>
<body class="min-vh-100 d-flex flex-column align-items-center justify-content-center px-4">
    <div class="mb-4 text-success">
        <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
    </div>
    <h2 class="fw-bold mb-3">Check your email</h2>
    <p class="text-muted mb-5 text-center" style="max-width: 400px;">
        Please check your email to reset your password.
    </p>
    <a asp-action="Login" class="btn btn-dark fw-bold px-4 py-2" style="border-radius: 0; letter-spacing: 0.5px;">
        BACK TO LOGIN
    </a>
</body>
</html>
