@{
    Layout = null;
    ViewData["Title"] = "Reset Link Sent";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StartupConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --sc-bg: #F5F2EC;
            --sc-card-bg: #FFFCF8;
            --sc-text-main: #29232F;
            --sc-text-muted: #716B76;
            --sc-border-beige: #E2DDD5;
            --sc-purple: #603B78;
            --sc-purple-hover: #4D2D63;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--sc-bg);
            color: var(--sc-text-main);
            min-height: 100vh;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Outfit', 'Inter', sans-serif;
            color: var(--sc-text-main);
        }

        .sc-form-card {
            background-color: var(--sc-card-bg);
            border-radius: 16px;
            border: 1px solid var(--sc-border-beige);
            box-shadow: 0 4px 24px rgba(41, 35, 47, 0.05), 0 1px 3px rgba(41, 35, 47, 0.02);
            padding: 2.5rem;
        }

        @@media (max-width: 576px) {
            .sc-form-card {
                padding: 2rem 1.25rem;
            }
        }

        .login-btn {
            background-color: var(--sc-purple) !important;
            color: #FFFFFF !important;
            border: none !important;
            border-radius: 10px;
            font-weight: 600;
            padding: 12px;
            letter-spacing: 0.5px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px rgba(96, 59, 120, 0.25);
            text-decoration: none;
            display: block;
        }

        .login-btn:hover {
            background-color: var(--sc-purple-hover) !important;
            color: #FFFFFF !important;
            box-shadow: 0 6px 20px rgba(96, 59, 120, 0.35);
            transform: translateY(-1px);
        }

        .brand-icon-box {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: rgba(96, 59, 120, 0.1);
            color: var(--sc-purple);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
        }

        .back-link {
            color: var(--sc-text-main) !important;
            transition: all 0.2s ease;
            opacity: 0.75;
        }

        .back-link:hover {
            color: var(--sc-purple) !important;
            opacity: 1;
        }
    </style>
</head>
<body class="min-vh-100 d-flex flex-column position-relative">

    <!-- Back Button -->
    <div class="position-absolute top-0 start-0 p-4 z-3">
        <a asp-controller="Account" asp-action="Login" class="back-link text-decoration-none fw-semibold d-inline-flex align-items-center">
            <i class="bi bi-arrow-left fs-5 me-2"></i> Back to Login
        </a>
    </div>

    <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center px-3 py-5">
        <div class="sc-form-card w-100 text-center" style="max-width: 460px;">
            <div class="brand-icon-box mb-3">
                <i class="bi bi-envelope-check-fill"></i>
            </div>
            <h2 class="fw-bold mb-2" style="font-size: 1.65rem;">Check your email</h2>
            <p class="text-muted small mb-4">
                If an account exists for that email, we have sent instructions and a link to reset your password. Please check your inbox and spam folder.
            </p>

            <a asp-controller="Account" asp-action="Login" class="btn login-btn w-100">
                BACK TO LOGIN
            </a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
