@{
    ViewData["HideConfirmBanner"] = true;
    ViewData["Title"] = "Check your email";
    var email = ViewBag.Email as string;
    var hours = ViewBag.ValidHours as int? ?? 2;
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5 text-center">
                    <i class="bi bi-envelope-check display-4 text-success d-block mb-3"></i>
                    <h3 class="fw-bold">Check your email</h3>
                    <p class="text-muted mb-4">
                        @if (string.IsNullOrEmpty(email))
                        {
                            <text>If that address belongs to a StartupConnect account, we've sent a link to reset your password.</text>
                        }
                        else
                        {
                            <text>If <strong class="text-dark">@email</strong> belongs to a StartupConnect account, we've sent a link to reset your password.</text>
                        }
                    </p>
                    <div class="bg-light rounded-3 p-3 text-start small text-muted mb-4">
                        <div class="mb-1"><i class="bi bi-clock me-1 text-primary"></i>The link is valid for @hours hour@(hours == 1 ? "" : "s") and works once.</div>
                        <div class="mb-1"><i class="bi bi-inbox me-1 text-primary"></i>Can't find it? Check your spam or promotions folder.</div>
                        <div><i class="bi bi-arrow-repeat me-1 text-primary"></i>Still nothing after a few minutes? Make sure the address is right and try again.</div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-action="Login" class="btn btn-primary rounded-pill py-2 fw-semibold">Back to log in</a>
                        <a asp-action="ForgotPassword" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold">Use a different email</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
