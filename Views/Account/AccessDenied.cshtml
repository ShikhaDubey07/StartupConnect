@{
    ViewData["Title"] = "Access denied";
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5 text-center">
                    <i class="bi bi-shield-x display-4 text-danger d-block mb-3"></i>
                    <h3 class="fw-bold">You don't have access to this page</h3>
                    <p class="text-muted mb-4">It may belong to another member or require a different role. If you think this is a mistake, contact support.</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Dashboard" class="btn btn-primary rounded-pill py-2 fw-semibold">Go to my dashboard</a>
                        <a asp-controller="Help" asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2 fw-semibold">Help &amp; support</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
