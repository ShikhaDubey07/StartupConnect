@model RegisterViewModel
@using StartupConnect.Models
@using StartupConnect.ViewModels
@{
    Layout = null;
    ViewData["Title"] = "Create Account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StartupConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --sc-bg: #F5F2EC;
            --sc-card-bg: #FFFCF8;
            --sc-text-main: #29232F;
            --sc-text-muted: #716B76;
            --sc-border-beige: #E2DDD5;
            --sc-purple: #603B78;
            --sc-purple-hover: #4D2D63;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--sc-bg);
            color: var(--sc-text-main);
            min-height: 100vh;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Outfit', 'Inter', sans-serif;
            color: var(--sc-text-main);
        }

        .sc-form-card {
            background-color: var(--sc-card-bg);
            border-radius: 16px;
            border: 1px solid var(--sc-border-beige);
            box-shadow: 0 4px 24px rgba(41, 35, 47, 0.05), 0 1px 3px rgba(41, 35, 47, 0.02);
            padding: 2.5rem;
        }

        @@media (max-width: 576px) {
            .sc-form-card {
                padding: 2rem 1.25rem;
            }
        }

        .form-label {
            color: var(--sc-text-muted) !important;
            font-weight: 600;
            font-size: 0.72rem;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: 0.4rem;
        }

        .form-control, .form-select {
            background-color: #FFFFFF !important;
            border: 1.5px solid var(--sc-border-beige) !important;
            border-radius: 10px !important;
            padding: 0.65rem 1rem !important;
            color: var(--sc-text-main) !important;
            font-size: 0.95rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .form-control::placeholder {
            color: #A39D98;
        }

        .form-control:focus, .form-select:focus {
            background-color: #FFFFFF !important;
            border-color: var(--sc-purple) !important;
            box-shadow: 0 0 0 3px rgba(96, 59, 120, 0.15) !important;
            color: var(--sc-text-main) !important;
        }

        .login-btn {
            background-color: var(--sc-purple) !important;
            color: #FFFFFF !important;
            border: none !important;
            border-radius: 10px;
            font-weight: 600;
            padding: 12px;
            letter-spacing: 0.5px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px rgba(96, 59, 120, 0.25);
        }

        .login-btn:hover {
            background-color: var(--sc-purple-hover) !important;
            color: #FFFFFF !important;
            box-shadow: 0 6px 20px rgba(96, 59, 120, 0.35);
            transform: translateY(-1px);
        }

        .login-btn:active {
            transform: translateY(0);
        }

        .login-btn.active {
            background-color: var(--sc-purple) !important;
            color: #FFFFFF !important;
        }

        .form-check-input {
            border-color: #D8D1CB !important;
            background-color: #FFFFFF !important;
            cursor: pointer;
        }

        .form-check-input:checked {
            background-color: var(--sc-purple) !important;
            border-color: var(--sc-purple) !important;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 3px rgba(96, 59, 120, 0.15) !important;
            border-color: var(--sc-purple) !important;
        }

        .form-check-label {
            color: var(--sc-text-main);
            cursor: pointer;
        }

        .brand-icon-box {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: rgba(96, 59, 120, 0.1);
            color: var(--sc-purple);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .back-link {
            color: var(--sc-text-main) !important;
            transition: all 0.2s ease;
            opacity: 0.75;
        }

        .back-link:hover {
            color: var(--sc-purple) !important;
            opacity: 1;
        }

        .auth-link {
            color: var(--sc-text-main);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .auth-link:hover {
            color: var(--sc-purple);
        }

        .selection-box {
            background: #FFFFFF;
            border: 1.5px solid var(--sc-border-beige);
            border-radius: 10px;
            padding: 0.85rem 1rem;
        }
    </style>
</head>
<body class="min-vh-100 d-flex flex-column position-relative">

    <!-- Back Button -->
    <div class="position-absolute top-0 start-0 p-4 z-3">
        <a asp-controller="Home" asp-action="Index" class="back-link text-decoration-none fw-semibold d-inline-flex align-items-center">
            <i class="bi bi-arrow-left fs-5 me-2"></i> Back
        </a>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center px-3 py-5">
        <div class="sc-form-card w-100 my-4" style="max-width: 680px;">
            <div class="text-center mb-4">
                <div class="brand-icon-box mb-3">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <h2 class="fw-bold mb-1" style="font-size: 1.75rem;">Create Account</h2>
                <p class="text-muted small mb-0">Join StartupConnect to discover ideas, partners, and investors.</p>
            </div>

            <form asp-action="Register" method="post" id="registerForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="Your full name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="you@email.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+91 9876543210" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label">Participation Type</label>
                        <select asp-for="Role" class="form-select">
                            <option value="">Select your participation type</option>
                            <option value="Founder">Founder</option>
                            <option value="Co-founder">Co-founder</option>
                            <option value="Worker">Worker</option>
                            <option value="Investor">Investor</option>
                            <option value="Mentor">Mentor</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label">Location (City, State)</label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Mumbai, MH" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TimeAvailability" class="form-label">Availability</label>
                        <select asp-for="TimeAvailability" asp-items="Html.GetEnumSelectList<TimeAvailability>()" class="form-select">
                            <option value="">Select Availability</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="InvestmentCapacity" class="form-label">Investment Capacity</label>
                        <select asp-for="InvestmentCapacity" asp-items="Html.GetEnumSelectList<InvestmentCapacity>()" class="form-select">
                            <option value="">Select Investment Capacity</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label mb-2">Skills</label>
                        <div class="selection-box d-flex flex-wrap gap-3">
                            @foreach (var skill in ProfileViewModel.AvailableSkills)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedSkills" value="@skill" id="skill_@skill.Replace(" ", "")"
                                        @(Model?.SelectedSkills?.Contains(skill) == true ? "checked" : "")>
                                    <label class="form-check-label small" for="skill_@skill.Replace(" ", "")">
                                        @skill
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label mb-2">Interests</label>
                        <div class="selection-box d-flex flex-wrap gap-3">
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var cat in (List<Category>)ViewBag.Categories)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedCategoryIds" value="@cat.Id" id="cat_@cat.Id"
                                            @(Model?.SelectedCategoryIds?.Contains(cat.Id) == true ? "checked" : "")>
                                        <label class="form-check-label small" for="cat_@cat.Id">
                                            @cat.Name
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirm password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-12 mt-4">
                        <button type="submit" class="btn login-btn w-100" id="registerBtn">
                            CREATE ACCOUNT
                        </button>
                    </div>
                </div>
            </form>
            
            <div class="mt-4 pt-3 border-top text-center" style="border-color: var(--sc-border-beige) !important;">
                <a asp-action="Login" class="auth-link fw-bold" style="font-size: 0.8rem;">ALREADY REGISTERED? LOG IN</a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        $(document).ready(function() {
            // Form Submit Loading
            $('#registerForm').on('submit', function(e) {
                var btn = $('#registerBtn');
                if (!btn.attr('data-loading') && $(this).valid()) {
                    e.preventDefault();
                    btn.attr('data-loading', 'true');
                    btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Creating...');
                    setTimeout(() => { this.submit(); }, 300);
                }
            });
        });
    </script>
</body>
</html>
