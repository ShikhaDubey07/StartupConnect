@model RegisterViewModel
@using StartupConnect.Models
@using StartupConnect.ViewModels
@{
    Layout = null;
    ViewData["Title"] = "Create Account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StartupConnect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #000;
        }
        .form-control:focus, .form-select:focus {
            box-shadow: none;
            border-color: #000 !important;
        }
        .border-bottom-only {
            border: 0;
            border-bottom: 1px solid #ccc !important;
            border-radius: 0;
            padding-left: 0;
            padding-right: 0;
            padding-bottom: 8px;
        }
        .border-bottom-only:focus {
            border-bottom: 1px solid #000 !important;
        }
        .login-btn {
            background-color: #f1f1f1;
            color: #a0a0a0;
            border: none;
            font-weight: 600;
            padding: 12px;
            letter-spacing: 0.5px;
            transition: all 0.2s;
        }
        .login-btn.active {
            background-color: #000;
            color: #000;
        }
        .login-btn.active:hover {
            background-color: #333;
        }
        .terms-text {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 30px;
        }
        .terms-text a {
            color: #666;
            text-decoration: underline;
        }
        .terms-text a:hover {
            color: #000;
        }
        .back-link {
            transition: opacity 0.2s;
            opacity: 0.6;
        }
        .back-link:hover {
            opacity: 1;
        }
    </style>
</head>
<body class="min-vh-100 d-flex flex-column position-relative">

    <!-- Back Button -->
    <div class="position-absolute top-0 start-0 p-4 z-3">
        <a asp-controller="Home" asp-action="Index" class="text-dark text-decoration-none fw-semibold d-inline-flex align-items-center back-link">
            <i class="bi bi-arrow-left fs-5 me-2"></i> Back
        </a>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center px-4 py-5" data-aos="zoom-in" data-aos-duration="600">
       
        <h2 class="fw-bold mb-3" style="font-size: 1.75rem;">Registration Form</h2>
        


        <!-- Email Registration Form -->
        <div class="w-100" style="max-width: 600px;">
            <form asp-action="Register" method="post" id="registerForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 mb-3"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Full Name</label>
                        <input asp-for="FullName" class="form-control border-bottom-only" placeholder="Your full name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Email Address</label>
                        <input asp-for="Email" class="form-control border-bottom-only" placeholder="you@email.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control border-bottom-only" placeholder="+91 9876543210" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Participation Type</label>
                        <select asp-for="Role" class="form-select border-bottom-only text-muted py-2" style="padding-left:0;">
                            <option value="">Select your participation type</option>
                            <option value="Founder">Founder</option>
                            <option value="Co-founder">Co-founder</option>
                            <option value="Worker">Worker</option>
                            <option value="Investor">Investor</option>
                            <option value="Mentor">Mentor</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Location (City, State)</label>
                        <input asp-for="Location" class="form-control border-bottom-only" placeholder="e.g. Mumbai, MH" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TimeAvailability" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Availability</label>
                        <select asp-for="TimeAvailability" asp-items="Html.GetEnumSelectList<TimeAvailability>()" class="form-select border-bottom-only text-muted py-2" style="padding-left:0;">
                            <option value="">Select Availability</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="InvestmentCapacity" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Investment Capacity</label>
                        <select asp-for="InvestmentCapacity" asp-items="Html.GetEnumSelectList<InvestmentCapacity>()" class="form-select border-bottom-only text-muted py-2" style="padding-left:0;">
                            <option value="">Select Investment Capacity</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label text-muted fw-semibold text-uppercase mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">Skills</label>
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var skill in ProfileViewModel.AvailableSkills)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedSkills" value="@skill" id="skill_@skill.Replace(" ", "")"
                                        @(Model?.SelectedSkills?.Contains(skill) == true ? "checked" : "")>
                                    <label class="form-check-label small" for="skill_@skill.Replace(" ", "")">
                                        @skill
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label text-muted fw-semibold text-uppercase mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">Interests</label>
                        <div class="d-flex flex-wrap gap-3">
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var cat in (List<Category>)ViewBag.Categories)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedCategoryIds" value="@cat.Id" id="cat_@cat.Id"
                                            @(Model?.SelectedCategoryIds?.Contains(cat.Id) == true ? "checked" : "")>
                                        <label class="form-check-label small" for="cat_@cat.Id">
                                            @cat.Name
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Password</label>
                        <input asp-for="Password" class="form-control border-bottom-only" type="password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="form-control border-bottom-only" type="password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    

                    
                    <div class="col-12 mt-4">
                        <button type="submit" class="btn login-btn w-100 active" id="registerBtn">
                            CREATE ACCOUNT
                        </button>
                    </div>
                </div>
            </form>
            
            <div class="mt-4 pt-2 text-center">
                <a asp-action="Login" class="text-dark text-decoration-none fw-bold" style="font-size: 0.8rem;">ALREADY REGISTERED? LOG IN</a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        $(document).ready(function() {
            // Form Submit Loading
            $('#registerForm').on('submit', function(e) {
                var btn = $('#registerBtn');
                if (!btn.attr('data-loading') && $(this).valid()) {
                    e.preventDefault();
                    btn.attr('data-loading', 'true');
                    btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Creating...');
                    setTimeout(() => { this.submit(); }, 300);
                }
            });
        });
    </script>
</body>
</html>
