@{
    ViewData["Title"] = "Smart Matches";
    var coFounders = (List<(StartupConnect.Models.UserProfile Profile, double Score)>)ViewBag.CoFounders;
    var investors = (List<StartupConnect.Models.UserProfile>)ViewBag.Investors;
    var ideas = (List<StartupConnect.Models.Idea>)ViewBag.IdeasToInvest;
    var coFounderRationales = ViewBag.CoFounderRationales as Dictionary<string, string> ?? new Dictionary<string, string>();
    var investorPitches = ViewBag.InvestorPitches as Dictionary<int, string> ?? new Dictionary<int, string>();
    var states = ViewBag.ConnectionStates as Dictionary<string, ConnectionState> ?? new Dictionary<string, ConnectionState>();
    string? Location(StartupConnect.Models.ApplicationUser u)
    {
        if (u.Settings != null && !u.Settings.ShowLocation) return null;
        var loc = string.Join(", ", new[] { u.City, u.State }.Where(v => !string.IsNullOrWhiteSpace(v)));
        return loc.Length == 0 ? null : loc;
    }
}

<div class="container py-5 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-people-fill text-primary me-2"></i>Smart Matches</h2>
    </div>

    <ul class="nav nav-pills mb-4" id="matchesTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4" id="cofounders-tab" data-bs-toggle="tab" data-bs-target="#cofounders" type="button" role="tab">
                Co-founders
            </button>
        </li>
        @if (investors.Any())
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 ms-2" id="investors-tab" data-bs-toggle="tab" data-bs-target="#investors" type="button" role="tab">
                    Investors for You
                </button>
            </li>
        }
        @if (ideas.Any())
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill px-4 ms-2" id="ideas-tab" data-bs-toggle="tab" data-bs-target="#ideas" type="button" role="tab">
                    Ideas to Invest In
                </button>
            </li>
        }
    </ul>

    <div class="tab-content" id="matchesTabsContent">
        <!-- Co-founders Tab -->
        <div class="tab-pane fade show active" id="cofounders" role="tabpanel">
            @if (coFounders.Any())
            {
                <div class="row g-4">
                    @foreach (var match in coFounders)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm border-0 sc-hover-card text-center p-4">
                                <div class="mx-auto mb-3"><partial name="_Avatar" model="@(new AvatarModel(match.Profile.User.FullName, match.Profile.ProfilePhotoUrl, 80))" /></div>
                                <h5 class="fw-bold mb-1">@match.Profile.User.FullName</h5>
                                <div class="text-muted small mb-2 fw-semibold">
                                    @(match.Profile.IsInvestor ? "Investor" : "Founder")
                                </div>
                                @if (Location(match.Profile.User) is string loc)
                                {
                                    <p class="text-muted small mb-2"><i class="bi bi-geo-alt"></i> @loc</p>
                                }
                                <div class="badge bg-success-subtle text-success mb-3 fs-6 px-3 py-2 border border-success border-opacity-25 rounded-pill shadow-sm">
                                    🔥 @match.Score% Match
                                </div>
                                
                                <div class="mb-3 text-start">
                                    <small class="text-muted d-block mb-1 fw-bold">Skills</small>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var skill in match.Profile.Skills.Take(3))
                                        {
                                            <span class="sc-role-tag">@skill.SkillName</span>
                                        }
                                        @if(match.Profile.Skills.Count > 3)
                                        {
                                            <span class="sc-role-tag bg-white text-muted">+@(match.Profile.Skills.Count - 3)</span>
                                        }
                                    </div>
                                </div>

                                <div class="mb-4 text-start">
                                    <small class="text-muted d-block mb-1 fw-bold">Industries & Interests</small>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var interest in match.Profile.InterestTags.Take(3))
                                        {
                                            <span class="badge bg-white text-dark border">@interest.Category.Name</span>
                                        }
                                    </div>
                                </div>

                                @if (coFounderRationales.TryGetValue(match.Profile.UserId, out var rationale))
                                {
                                    <div class="text-start mb-3 px-2 py-2 rounded-3" style="background:rgba(var(--bs-primary-rgb),.06);border-left:3px solid var(--bs-primary)">
                                        <small class="text-muted fst-italic"><i class="bi bi-robot me-1 text-primary"></i>@rationale</small>
                                    </div>
                                }

                                <div class="d-flex gap-2 mt-auto">
                                    <a asp-controller="Profile" asp-action="Detail" asp-route-id="@match.Profile.UserId" class="btn btn-outline-primary rounded-pill flex-grow-1">View</a>
                                    <partial name="_ConnectButton" model="@(new ConnectButtonModel(match.Profile.UserId, states.GetValueOrDefault(match.Profile.UserId), match.Profile.User.FullName))" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-light border text-center p-5 rounded-4">
                    <i class="bi bi-person-x fs-1 text-muted mb-3 d-block"></i>
                    <h5>No co-founder matches yet</h5>
                    <p class="text-muted mb-0">Update your profile with more skills and interests to get better matches.</p>
                </div>
            }
        </div>

        <!-- Investors Tab -->
        <div class="tab-pane fade" id="investors" role="tabpanel">
            <div class="row g-4">
                @foreach (var inv in investors)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 sc-hover-card p-4">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <partial name="_Avatar" model="@(new AvatarModel(inv.User.FullName, inv.ProfilePhotoUrl, 52))" />
                                <div class="min-w-0">
                                    <h5 class="fw-bold mb-0 text-truncate">@inv.User.FullName</h5>
                                    @if (Location(inv.User) is string invLoc)
                                    {
                                        <div class="text-muted small"><i class="bi bi-geo-alt"></i> @invLoc</div>
                                    }
                                </div>
                            </div>
                            <p class="text-muted small mb-2"><i class="bi bi-cash-coin me-1"></i>Ticket size: <strong class="text-dark">@StartupConnect.Services.InvestorDashboardService.CapacityLabel(inv.InvestmentCapacity)</strong></p>
                            @if (inv.InterestTags.Any())
                            {
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    @foreach (var tag in inv.InterestTags.Take(4)) { <span class="badge bg-white text-dark border">@tag.Category.Name</span> }
                                </div>
                            }
                            <div class="d-flex gap-2 mt-auto">
                                <a asp-controller="Profile" asp-action="Detail" asp-route-id="@inv.UserId" class="btn btn-outline-primary rounded-pill flex-grow-1">View</a>
                                <partial name="_ConnectButton" model="@(new ConnectButtonModel(inv.UserId, states.GetValueOrDefault(inv.UserId), inv.User.FullName))" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Ideas to Invest In Tab -->
        <div class="tab-pane fade" id="ideas" role="tabpanel">
            <div class="row g-4">
                @foreach (var idea in ideas)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 sc-hover-card p-4">
                            <h5 class="fw-bold">@idea.Title</h5>
                            <p class="text-muted small">By: @idea.Submitter.FullName</p>
                            <p class="mb-3">Requires: ₹@idea.MinimumFundRequired.ToString("N0")</p>
                            @if (investorPitches.TryGetValue(idea.Id, out var pitch))
                            {
                                <div class="mb-3 px-3 py-2 rounded-3" style="background:rgba(var(--bs-success-rgb),.07);border-left:3px solid var(--bs-success)">
                                    <small class="text-muted fst-italic"><i class="bi bi-robot me-1 text-success"></i>@pitch</small>
                                </div>
                            }
                            <a asp-controller="Ideas" asp-action="Detail" asp-route-id="@idea.Id" class="btn btn-primary-sc rounded-pill mt-auto">View Idea</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
