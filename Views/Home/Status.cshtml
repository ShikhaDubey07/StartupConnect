@{
    int code = ViewBag.Code ?? 404;
    var (icon, heading, text) = code switch
    {
        404 => ("bi-signpost-split", "We couldn't find that page", "The link may be broken, or the idea or page may have been removed or isn't public yet."),
        403 => ("bi-shield-x", "You don't have access to this", "This page belongs to another member or needs a different role."),
        429 => ("bi-hourglass-split", "Slow down a little", "You're doing that too often. Please wait a few minutes and try again."),
        400 => ("bi-exclamation-diamond", "Something about that request wasn't right", "Please go back and try again."),
        _ => ("bi-exclamation-triangle", "Something went wrong", "Please try again in a moment.")
    };
    ViewData["Title"] = heading;
}

<div class="container py-5 mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5 text-center">
                    <i class="bi @icon display-4 text-primary d-block mb-3"></i>
                    <p class="text-muted small text-uppercase fw-semibold mb-1">Error @code</p>
                    <h3 class="fw-bold">@heading</h3>
                    <p class="text-muted mb-4">@text</p>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">Go home</a>
                        <a asp-controller="Ideas" asp-action="Browse" class="btn btn-outline-secondary rounded-pill px-4">Explore ideas</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
