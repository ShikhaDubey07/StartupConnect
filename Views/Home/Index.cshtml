@{
    ViewData["Title"] = "Home";
    var featured = ViewBag.FeaturedIdeas as List<StartupConnect.ViewModels.IdeaCardViewModel>;
    var mostLiked = ViewBag.MostLikedIdeas as List<StartupConnect.ViewModels.IdeaCardViewModel>;
    dynamic stats = ViewBag.Stats;
}

<!-- Glassmorphism Welcome Popup -->
<div id="welcomeOverlay" class="glass-overlay">
    <div class="glass-card position-relative">
        <button type="button" class="btn-close position-absolute top-0 end-0 m-4" id="closeWelcomeBtn" aria-label="Close"></button>
        <div class="glass-icon-container">
            <i class="bi bi-rocket-takeoff glass-icon"></i>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <h2 class="glass-title">Welcome Back, @(User.Identity.Name?.Split('@')[0] ?? "Entrepreneur")! 🚀 </h2>
            <p class="glass-subtitle">
                Ready to make an impact today? Let's build together. 💡🤝 
            </p>
        }
        else
        {
            <h2 class="glass-title">Welcome to StartupConnect 🚀 </h2>
            <p class="glass-subtitle">
                Where ideas meet people, opportunities & innovation . 💡🤝 
            </p>
        }
    </div>
</div>

<style>
    .glass-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: radial-gradient(circle at center, rgba(15, 23, 42, 0.3) 0%, rgba(15, 23, 42, 0.6) 100%);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.8s ease, visibility 0.8s;
        pointer-events: none;
    }
    
    .glass-overlay.show-glass {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }
    
    .glass-card {
        background: rgba(0,0,0, 0.75);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid rgba(0,0,0, 0.6);
        border-radius: 28px;
        padding: 3.5rem 2.5rem 2.5rem;
        text-align: center;
        max-width: 540px;
        width: 90%;
        box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.25), inset 0 0 20px rgba(0,0,0, 0.5);
        transform: translateY(30px) scale(0.95);
        transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    
    .glass-overlay.show-glass .glass-card {
        transform: translateY(0) scale(1);
    }
    
    .glass-icon-container {
        width: 88px;
        height: 88px;
        margin: -6rem auto 1.5rem;
        background: linear-gradient(135deg, #000000 0%, #f1f5f9 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.15), 0 0 0 8px rgba(0,0,0, 0.5);
        animation: floatGlassIcon 3s ease-in-out infinite;
    }
    
    .glass-icon {
        font-size: 2.5rem;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    .glass-title {
        font-family: 'Outfit', 'Inter', system-ui, -apple-system, sans-serif;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
    }
    
    .glass-subtitle {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #334155;
        font-size: 1.15rem;
        line-height: 1.6;
        margin-bottom: 0;
        font-weight: 500;
    }
    
    @@keyframes floatGlassIcon {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-12px); }
        100% { transform: translateY(0px); }
    }
</style>

<!-- Hero -->
<section class="sc-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 sc-hero-content" data-aos="fade-right">
                <span class="sc-section-label"><i class="bi bi-flag-fill"></i> Built for Indian Youth 🇮🇳</span>
                <h1>Don't Start Alone.<br><span class="highlight">Build Together.</span></h1>
                <p class="sc-hero-sub">Connect with co-founders, skilled teammates, and investors. Submit your startup idea or join one — and launch your dream with a team behind you.</p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Account" asp-action="Dashboard" class="btn btn-accent btn-lg px-4">
                            <i class="bi bi-speedometer2 me-2"></i>Go to Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-accent btn-lg px-4">
                            <i class="bi bi-person-plus me-2"></i>Join Free
                        </a>
                    }
                    <a asp-controller="Ideas" asp-action="Browse" class="btn btn-outline-dark btn-lg px-4">
                        <i class="bi bi-search me-2"></i>Explore Ideas
                    </a>
                </div>
                <div class="sc-hero-stats">
                    <div class="sc-stat-item">
                        <div class="sc-stat-number">@stats.Users+</div>
                        <div class="sc-stat-label">Youth Connected</div>
                    </div>
                    <div class="sc-stat-item">
                        <div class="sc-stat-number">@stats.Ideas+</div>
                        <div class="sc-stat-label">Verified Ideas</div>
                    </div>
                    <div class="sc-stat-item">
                        <div class="sc-stat-number">@stats.Interests+</div>
                        <div class="sc-stat-label">Interests Shown</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 sc-hero-visual" data-aos="fade-left" data-aos-delay="200">
                <div id="heroCarousel" class="carousel slide shadow-lg rounded-4 overflow-hidden" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
                    </div>
                    <div class="carousel-inner">
                        <div class="carousel-item active" data-bs-interval="4000">
                            <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" class="d-block w-100" alt="Team collaborating" style="height: 450px; object-fit: cover;">
                            <div class="carousel-caption d-none d-md-block bg-white bg-opacity-50 rounded px-3 py-2">
                                <h5 class="text-black mb-1">Build Together</h5>
                                <p class="mb-0">Find the right co-founders for your startup.</p>
                            </div>
                        </div>
                        <div class="carousel-item" data-bs-interval="4000">
                            <img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" class="d-block w-100" alt="Startup meeting" style="height: 450px; object-fit: cover;">
                            <div class="carousel-caption d-none d-md-block bg-white bg-opacity-50 rounded px-3 py-2">
                                <h5 class="text-black mb-1">Discuss & Innovate</h5>
                                <p class="mb-0">Brainstorm with talented individuals.</p>
                            </div>
                        </div>
                        <div class="carousel-item" data-bs-interval="4000">
                            <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" class="d-block w-100" alt="Pitch" style="height: 450px; object-fit: cover;">
                            <div class="carousel-caption d-none d-md-block bg-white bg-opacity-50 rounded px-3 py-2">
                                <h5 class="text-black mb-1">Get Funded</h5>
                                <p class="mb-0">Present to micro-investors on our platform.</p>
                            </div>
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Problems -->
