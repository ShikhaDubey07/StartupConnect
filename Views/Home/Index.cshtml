<!-- Featured Ideas -->
@if (featured?.Any() == true)
{
    <section class="py-5 bg-white">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2" data-aos="fade-up">
                <div>
                    <span class="sc-section-label">Verified Ideas</span>
                    <h2 class="sc-heading mb-0">Featured Startups</h2>
                </div>
                <a asp-controller="Ideas" asp-action="Browse" class="btn btn-primary-sc">View All <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
            <div class="row g-4">
                @foreach (var idea in featured)
                {
                    <div class="col-md-6 col-lg-4">
                        @await Html.PartialAsync("_IdeaCard", idea)
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Most Liked Ideas This Week -->
@if (mostLiked?.Any() == true)
{
    <section class="py-5 bg-white">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2" data-aos="fade-up">
                <div>
                    <span class="sc-section-label">Trending Now</span>
                    <h2 class="sc-heading mb-0">Most Liked Ideas This Week</h2>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var idea in mostLiked)
                {
                    <div class="col-md-6 col-lg-4">
                        @await Html.PartialAsync("_IdeaCard", idea)
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- How It Works Preview -->
<section class="sc-steps-section">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="sc-heading">How StartupConnect Works</h2>
            <p class="opacity-75">From registration to launch in 5 simple steps</p>
        </div>
        <div class="row g-3">
            @foreach (var (num, title, desc) in new[] {
                ("1", "Register & Profile", "Share your interests, skills, time & investment capacity"),
                ("2", "Submit or Browse", "Post your idea or explore verified startups"),
                ("3", "Panel Verification", "Expert panel reviews and approves quality ideas"),
                ("4", "Show Interest", "Work, invest, or both — on ideas you believe in"),
                ("5", "Launch Together", "Form teams, get support, and start your startup")
            })
            {
                <div class="col-6 col-lg" data-aos="zoom-in" data-aos-delay="100">
                    <div class="sc-step-card">
                        <div class="sc-step-number">@num</div>
                        <h6>@title</h6>
                        <p class="small opacity-75 mb-0">@desc</p>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-controller="Home" asp-action="HowItWorks" class="btn btn-accent btn-lg">Learn More</a>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="sc-cta-section">
    <div class="container text-center" data-aos="zoom-in">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <h2 class="mb-3" style="color: #FFFFFF !important;">Continue Building Your Dream</h2>
            <p class="mb-4 opacity-75" style="color: #FFFFFF !important;">Head to your dashboard to manage your startup journey.</p>
            <a asp-controller="Account" asp-action="Dashboard" class="btn btn-dark btn-lg px-5" style="color: #FFFFFF !important;">
                <i class="bi bi-speedometer2 me-2"></i>Go to Dashboard
            </a>
        }
        else
        {
            <h2 class="mb-3" style="color: #FFFFFF !important;">Ready to Build India's Next Big Startup?</h2>
            <p class="mb-4 opacity-75" style="color: #FFFFFF !important;">Join thousands of young entrepreneurs. It's free to register.</p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-dark btn-lg px-5" style="color: #FFFFFF !important;">
                <i class="bi bi-rocket-takeoff me-2"></i>Get Started Now
            </a>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const overlay = document.getElementById('welcomeOverlay');
            const closeBtn = document.getElementById('closeWelcomeBtn');
            
            if (!localStorage.getItem('sc_welcome_shown')) {
                // Show after brief delay
                setTimeout(() => {
                    overlay.classList.add('show-glass');
                }, 300);
                
                // Automatically hide after exactly 4 seconds
                let autoHideTimer = setTimeout(() => {
                    overlay.classList.remove('show-glass');
                    localStorage.setItem('sc_welcome_shown', 'true');
                }, 4300); // 300ms delay + 4000ms display time
                
                // Manual close
                closeBtn.addEventListener('click', function() {
                    clearTimeout(autoHideTimer);
                    overlay.classList.remove('show-glass');
                    localStorage.setItem('sc_welcome_shown', 'true');
                });
            }
        });
    </script>
}
