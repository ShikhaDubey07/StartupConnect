@model StartupConnect.Models.StartupChallenge
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <h1 class="fw-bold mb-3">@Model.Title</h1>
            <div class="d-flex gap-3 mb-4">
                <span class="badge bg-success fs-6 px-3 py-2">Prize: @Model.Prize</span>
                <span class="badge bg-secondary fs-6 px-3 py-2">Deadline: @Model.Deadline.ToString("MMMM dd, yyyy")</span>
            </div>
            
            <div class="card sc-idea-card mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Challenge Description</h5>
                    <p class="text-muted" style="white-space: pre-wrap">@Model.Description</p>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card sc-idea-card">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Submit Your Idea</h4>
                    <p class="text-muted small">Select one of your existing ideas to submit to this challenge.</p>
                    
                    @if(User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-action="SubmitIdea" method="post">
                            <input type="hidden" name="challengeId" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label">Select Idea</label>
                                <select name="ideaId" class="form-select">
                                    <option value="">-- Choose an Idea --</option>
                                    <!-- In a real app, populate this with user's ideas -->
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Pitch Notes</label>
                                <textarea name="pitchNotes" class="form-control" rows="3"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Submit to Challenge</button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            Please <a asp-controller="Account" asp-action="Login">login</a> to participate.
                        </div>
                    }
                </div>
            </div>
            
            <div class="card sc-idea-card mt-4">
                <div class="card-body">
                    <h5 class="fw-bold">Current Submissions</h5>
                    <div class="display-4 fw-bold text-primary mt-2">@Model.Submissions.Count</div>
                </div>
            </div>
        </div>
    </div>
</div>
