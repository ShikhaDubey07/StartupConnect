@model IdeaDetailViewModel
@{
    ViewData["Title"] = Model.Title;
    var fundPercent = Model.MinimumFundRequired > 0 ? Math.Min(100, (int)(Model.TotalPledged / Model.MinimumFundRequired * 100)) : 0;
    var roadmap = ViewBag.Roadmap as RoadmapViewModel ?? new RoadmapViewModel();
    var teamMembers = ViewBag.TeamMembers as List<WorkspaceMemberViewModel> ?? new List<WorkspaceMemberViewModel>();
    var canOpenWorkspace = ViewBag.CanOpenWorkspace as bool? == true;
    var viewableProfiles = ViewBag.ViewableProfiles as HashSet<string> ?? new HashSet<string>();
    var hiddenMembers = ViewBag.HiddenMembers as HashSet<string> ?? new HashSet<string>();
}

<section class="sc-detail-hero">
    <div class="container">
        <span class="sc-idea-category mb-2 d-inline-block"><i class="bi bi-tag"></i> @Model.CategoryName</span>
        <h1 class="mb-2">@Model.Title</h1>
        <p class="opacity-75 fs-5 mb-3">@Model.Tagline</p>
        <div class="d-flex flex-wrap gap-3 small">
            <span>
                <i class="bi bi-person me-1"></i>
                @if (viewableProfiles.Contains(Model.SubmitterId))
                {
                    <a asp-controller="Profile" asp-action="Detail" asp-route-id="@Model.SubmitterId" class="text-reset">@Model.SubmitterName</a>
                }
                else
                {
                    <span>@Model.SubmitterName</span>
                }
                @if (Model.SubmitterVerified) { <partial name="_VerifiedBadge" /> }
                @(Model.SubmitterCity != null ? $"· {Model.SubmitterCity}" : "")
            </span>
            <span><i class="bi bi-people me-1"></i> @Model.InterestCount interested</span>
            <span><i class="bi bi-heart-fill text-danger me-1"></i> <span id="likesCountHero">@Model.LikesCount</span> likes</span>
            <span><i class="bi bi-calendar me-1"></i> @(Model.PublishedAt?.ToString("MMM dd, yyyy") ?? "")</span>
        </div>
    </div>
</section>

<div class="container pb-5 mt-n3">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="sc-detail-section mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-bar-chart-steps me-2 text-primary"></i>Idea Progress</h5>
                @if (Model.IsOwner)
                {
                    <form asp-action="UpdateProgress" method="post" class="d-flex align-items-center gap-3">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <select name="stage" class="form-select w-auto">
                            @foreach (var stage in Enum.GetValues(typeof(IdeaProgressStage)))
                            {
                                if ((IdeaProgressStage)stage == ViewBag.ProgressStage)
                                {
                                    <option value="@stage" selected>@stage</option>
                                }
                                else
                                {
                                    <option value="@stage">@stage</option>
                                }
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary-sc">Update Stage</button>
                    </form>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary fs-6 py-2 px-3">@ViewBag.ProgressStage</span>
                        <span class="text-muted small">Current stage of the idea.</span>
                    </div>
                }
            </div>

            <div class="sc-detail-section">
                <h5 class="fw-bold mb-3"><i class="bi bi-file-text me-2 text-warning"></i>Description</h5>
                <p>@Model.Description</p>
            </div>
            <div class="sc-detail-section">
                <h5 class="fw-bold mb-3"><i class="bi bi-exclamation-triangle me-2 text-danger"></i>Problem</h5>
                <p>@Model.ProblemStatement</p>
            </div>
            <div class="sc-detail-section">
                <h5 class="fw-bold mb-3"><i class="bi bi-lightbulb me-2 text-warning"></i>Solution</h5>
                <p>@Model.Solution</p>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="sc-detail-section h-100">
                        <h6 class="fw-bold">Target Market</h6>
                        <p class="mb-0 text-muted">@Model.TargetMarket</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="sc-detail-section h-100">
                        <h6 class="fw-bold">Business Model</h6>
                        <p class="mb-0 text-muted">@Model.BusinessModel</p>
                    </div>
                </div>
            </div>

            <div class="sc-detail-section mt-4" id="roadmap">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-signpost-2 me-2 text-success"></i>Roadmap &amp; progress</h5>
                    @if (roadmap.Total > 0)
                    {
                        <span class="small text-muted">@roadmap.Done of @roadmap.Total milestones · <strong>@roadmap.Percent%</strong></span>
                    }
                </div>
                @if (roadmap.Total == 0)
                {
                    <p class="text-muted small mb-0">
                        @if (Model.IsOwner)
                        {
                            @:No milestones yet. Plan your roadmap in the team workspace — it shows up here for everyone.
                        }
                        else
                        {
                            @:The team hasn't published any milestones yet.
                        }
                    </p>
                }
                else
                {
                    <div class="progress sc-milestone-progress mb-3" role="progressbar" aria-label="Roadmap progress" aria-valuenow="@roadmap.Percent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@roadmap.Percent%"></div></div>
                    <ol class="sc-roadmap list-unstyled mb-0">
                        @foreach (var m in roadmap.Milestones)
                        {
                            <li class="@(m.IsCompleted ? "is-done" : "")">
                                <span class="sc-roadmap-dot"><i class="bi @(m.IsCompleted ? "bi-check-lg" : "bi-circle")"></i></span>
                                <div>
                                    <div class="fw-semibold">@m.Title</div>
                                    <div class="small text-muted">
                                        @if (m.IsCompleted && m.CompletedAt.HasValue)
                                        {
                                            @:Completed @StartupConnect.Infrastructure.AppTime.ToIst(m.CompletedAt.Value).ToString("MMM dd, yyyy")
                                        }
                                        else if (m.DueDate.HasValue)
                                        {
                                            @:Target @m.DueDate.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            @:Planned
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </div>

            @if (Model.PreviousVersion != null)
            {
                <div class="sc-detail-section mt-4 mb-4 border-start border-4 border-secondary shadow-sm bg-white position-relative hover-shadow" 
                     style="border-radius: 12px; cursor: pointer; transition: all 0.2s;" 
                     data-bs-toggle="modal" data-bs-target="#historyModal" 
                     onclick="loadIdeaHistory(@Model.Id)">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="fw-bold text-secondary mb-0"><i class="bi bi-clock-history me-2"></i>Version History</h5>
                        <span class="badge bg-secondary">Updated @Model.PreviousVersion.EditedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <p class="text-muted small mb-0">This idea has been edited. Click here to view the full version history.</p>
                    <div class="position-absolute top-50 end-0 translate-middle-y pe-3">
                        <i class="bi bi-chevron-right text-muted fs-4"></i>
                    </div>
                </div>
            }



            <!-- AI Analysis Section -->
            @if (Model.Analysis != null)
            {
                <div class="sc-detail-section mb-4 border-start border-4 border-accent shadow-sm bg-white" style="border-radius: 12px; position: relative;">
                    <div class="position-absolute top-0 end-0 p-3">
                        <span class="badge bg-accent bg-opacity-10 text-accent fs-6">
                            <i class="bi bi-robot me-1"></i> AI Score: @Model.Analysis.OverallScore/100
                        </span>
                    </div>
                    
                    <h4 class="fw-bold mb-4 text-accent"><i class="bi bi-stars me-2"></i>AI Idea Analysis</h4>
                    
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark">Executive Summary</h6>
                        <p class="text-muted">@Model.Analysis.Summary</p>
                    </div>
                    
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="h-100 p-3 bg-white rounded">
                                <h6 class="fw-bold"><i class="bi bi-bullseye me-2 text-primary"></i>Target Users</h6>
                                <p class="mb-0 text-muted small" style="white-space: pre-wrap;">@Model.Analysis.TargetUsers</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="h-100 p-3 bg-white rounded">
                                <h6 class="fw-bold"><i class="bi bi-graph-up-arrow me-2 text-success"></i>Market Potential</h6>
                                <p class="mb-0 text-muted small" style="white-space: pre-wrap;">@Model.Analysis.MarketPotential</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="h-100 p-3 bg-white rounded">
                                <h6 class="fw-bold"><i class="bi bi-cash-stack me-2 text-warning"></i>Revenue Models</h6>
                                <p class="mb-0 text-muted small" style="white-space: pre-wrap;">@Model.Analysis.RevenueModels</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="h-100 p-3 bg-white rounded">
                                <h6 class="fw-bold"><i class="bi bi-shield-exclamation me-2 text-danger"></i>Risks & Challenges</h6>
                                <p class="mb-0 text-muted small" style="white-space: pre-wrap;">@Model.Analysis.Risks</p>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold"><i class="bi bi-people-fill me-2 text-info"></i>Team Suggestions</h6>
                        <p class="text-muted small">@Model.Analysis.TeamSuggestions</p>
                    </div>

                    @if (Model.Analysis.SimilarIdeas.Any())
                    {
                        <h6 class="fw-bold"><i class="bi bi-files me-2 text-secondary"></i>Similar Concepts Detected</h6>
                        <div class="row g-3">
                            @foreach (var similar in Model.Analysis.SimilarIdeas)
                            {
                                <div class="col-md-6">
                                    <div class="card h-100 border-0 bg-white shadow-sm">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between mb-2">
                                                <strong class="text-dark">@similar.Title</strong>
                                                <span class="badge bg-secondary">@similar.MatchPercentage% match</span>
                                            </div>
                                            <p class="small text-muted mb-0">@similar.Detail</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    
                    <div class="text-end mt-4 pt-3 border-top">
                        <small class="text-muted me-3">Generated on @Model.Analysis.GeneratedAt.ToString("MMM dd, yyyy HH:mm")</small>
                        @if (Model.IsOwner || User.IsInRole("Admin"))
                        {
                            <form asp-action="RegenerateAnalysis" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-accent" onclick="this.innerHTML='<span class=\'spinner-border spinner-border-sm me-1\'></span> Regenerating...';">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Regenerate
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }

            <!-- Social Action Bar -->
            <div class="d-flex gap-3 align-items-center mt-4 pb-4 border-bottom">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="btn @(Model.IsLikedByCurrentUser ? "btn-danger" : "btn-outline-danger") rounded-pill px-4 toggle-like-btn" data-id="@Model.Id">
                        <i class="bi @(Model.IsLikedByCurrentUser ? "bi-heart-fill" : "bi-heart") me-2"></i>
                        <span class="like-text">@(Model.IsLikedByCurrentUser ? "Liked" : "Like")</span> 
                        (<span class="likes-count">@Model.LikesCount</span>)
                    </button>
                    <button class="btn @(Model.IsSavedByCurrentUser ? "btn-primary" : "btn-outline-primary") rounded-pill px-4 toggle-save-detail-btn" data-id="@Model.Id">
                        <i class="bi @(Model.IsSavedByCurrentUser ? "bi-bookmark-fill" : "bi-bookmark") me-2 save-icon"></i>
                        <span class="save-text">@(Model.IsSavedByCurrentUser ? "Saved" : "Save")</span>
                    </button>
                    <button class="btn btn-outline-secondary rounded-pill px-4 share-btn">
                        <i class="bi bi-share me-2"></i>Share
                    </button>
                    <button class="btn btn-outline-secondary rounded-pill px-4 ms-auto" data-bs-toggle="modal" data-bs-target="#reportModal">
                        <i class="bi bi-flag me-2"></i>Report
                    </button>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-danger rounded-pill px-4">
                        <i class="bi bi-heart me-2"></i>Like (@Model.LikesCount)
                    </a>
                    <button class="btn btn-outline-secondary rounded-pill px-4 share-btn">
                        <i class="bi bi-share me-2"></i>Share
                    </button>
                }
            </div>

            <!-- Comments Section -->
            <div class="mt-5">
                <h4 class="fw-bold mb-4">Comments (@Model.Comments.Count)</h4>
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Ideas" asp-action="AddComment" method="post" class="mb-5">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="d-flex gap-3">
                            <div class="sc-avatar bg-accent text-black rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:48px;height:48px">
                                @(User.Identity.Name?.FirstOrDefault().ToString().ToUpper())
                            </div>
                            <div class="flex-grow-1">
                                <textarea name="content" class="form-control rounded-3" rows="3" placeholder="Add a comment..." required maxlength="1000"></textarea>
                                <div class="text-end mt-2">
                                    <button type="submit" class="btn btn-primary-sc px-4 rounded-pill">Post Comment</button>
                                </div>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-light border mb-5 d-flex align-items-center justify-content-between">
                        <span>Please log in to add a comment.</span>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary">Log In</a>
                    </div>
                }

                <div class="comments-list">
                    @foreach (var comment in Model.Comments)
                    {
                        <div class="d-flex gap-3 mb-4">
                            <div class="sc-avatar bg-white text-dark rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-bold" style="width:48px;height:48px">
                                @(comment.UserName.FirstOrDefault().ToString().ToUpper())
                            </div>
                            <div class="flex-grow-1 bg-white p-3 rounded-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <strong class="text-dark">@comment.UserName</strong>
                                    <span class="small text-muted">@comment.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                                <p class="mb-0 text-dark opacity-75">@comment.Content</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (ViewBag.SimilarIdeas is List<StartupConnect.Services.Matching.SimilarIdeaMatch> similarIdeas && similarIdeas.Any())
            {
                <div class="mt-5">
                    <h4 class="fw-bold mb-1">Similar Ideas</h4>
                    <p class="text-muted small mb-4">Based on overlapping topics in the title, problem and solution, plus category and target market.</p>
                    <div class="row g-3">
                        @foreach (var match in similarIdeas)
                        {
                            <div class="col-md-6">
                                <div class="card h-100 shadow-sm border-0 sc-hover-card">
                                    <div class="card-body d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                            <h5 class="card-title fw-bold mb-0 sc-clamp-2">@match.Title</h5>
                                            <span class="badge bg-success-subtle text-success flex-shrink-0">@match.Score% similar</span>
                                        </div>
                                        <div class="small text-muted mb-2"><i class="bi @match.CategoryIcon me-1"></i>@match.CategoryName · by @match.SubmitterName</div>
                                        <p class="card-text text-muted small mb-2 sc-clamp-2">@match.Tagline</p>
                                        <ul class="list-unstyled sc-similar-reasons mb-3">
                                            @if (match.SameCategory) { <li><i class="bi bi-check-circle"></i>Same category</li> }
                                            @if (match.SimilarMarket) { <li><i class="bi bi-check-circle"></i>Similar target market</li> }
                                            @if (match.CommonKeywords.Any())
                                            {
                                                <li><i class="bi bi-hash"></i>@foreach (var kw in match.CommonKeywords.Take(4)) { <span class="sc-keyword">@kw</span> }</li>
                                            }
                                        </ul>
                                        <a asp-action="Detail" asp-route-id="@match.IdeaId" class="btn btn-sm btn-outline-primary stretched-link mt-auto align-self-start">View Idea</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="sc-detail-section sticky-top" style="top:90px">
                <h5 class="fw-bold mb-3">Funding Progress</h5>
                <div class="d-flex justify-content-between mb-1">
                    <span class="sc-fund-badge fs-6">₹@Model.TotalPledged.ToString("N0") pledged</span>
                    <span class="text-muted small">of ₹@Model.MinimumFundRequired.ToString("N0")</span>
                </div>
                <div class="sc-fund-progress mb-3">
                    <div class="bar" style="width:@fundPercent%"></div>
                </div>
                <p class="small text-muted mb-3">@fundPercent% of minimum fund requirement met</p>

                <h6 class="fw-bold mb-2">Roles Needed</h6>
                <div class="mb-3">
                    @foreach (var role in Model.RolesNeeded)
                    {
                        <span class="sc-role-tag">@role</span>
                    }
                </div>

                <p class="small text-muted mb-3"><i class="bi bi-people me-1"></i> Expected team size: @Model.ExpectedTeamSize</p>

                @if (canOpenWorkspace)
                {
                    <a asp-controller="Workspace" asp-action="ForIdea" asp-route-id="@Model.Id" class="btn btn-primary-sc w-100 mb-3"><i class="bi bi-kanban me-2"></i>Open Workspace</a>
                }

                @if (teamMembers.Any())
                {
                    <h6 class="fw-bold mb-2">Team <span class="text-muted fw-normal small">· @teamMembers.Count member@(teamMembers.Count == 1 ? "" : "s")</span></h6>
                    <ul class="list-unstyled mb-3">
                        @foreach (var tm in teamMembers)
                        {
                            var hidden = hiddenMembers.Contains(tm.UserId);
                            <li class="d-flex align-items-center gap-2 mb-2">
                                @if (hidden)
                                {
                                    <span class="sc-initials-avatar sc-avatar-c0 flex-shrink-0" style="width:30px;height:30px;font-size:12px" aria-hidden="true"><i class="bi bi-lock-fill"></i></span>
                                }
                                else
                                {
                                    <partial name="_Avatar" model="@(new AvatarModel(tm.FullName, tm.PhotoUrl, 30))" />
                                }
                                <div class="small min-w-0">
                                    @if (hidden)
                                    {
                                        <span class="text-muted fw-semibold">Private member</span>
                                    }
                                    else if (viewableProfiles.Contains(tm.UserId))
                                    {
                                        <a asp-controller="Profile" asp-action="Detail" asp-route-id="@tm.UserId" class="text-dark fw-semibold">@tm.FullName</a>
                                    }
                                    else
                                    {
                                        <span class="text-dark fw-semibold">@tm.FullName</span>
                                    }
                                    @if (tm.IsVerified && !hidden) { <partial name="_VerifiedBadge" /> }
                                    <div class="text-muted text-truncate">@tm.Role</div>
                                </div>
                            </li>
                        }
                    </ul>
                }

                @if (Model.CanShowInterest)
                {
                    <button class="btn btn-accent btn-lg w-100" data-bs-toggle="modal" data-bs-target="#interestModal">
                        <i class="bi bi-hand-index me-2"></i>Show Interest
                    </button>
                }
                else if (Model.IsOwner)
                {
                    <div class="alert alert-info small mb-0">This is your idea.</div>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-accent btn-lg w-100">Login to Show Interest</a>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.CanShowInterest)
{
    <div class="modal fade" id="interestModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius:16px">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Show Interest</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="interestForm" asp-controller="Interests" asp-action="Submit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdeaId" value="@Model.Id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">How do you want to contribute?</label>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var type in Enum.GetValues<InterestType>())
                                {
                                    <label class="border rounded p-3 d-flex align-items-center gap-2" style="cursor:pointer">
                                        <input type="radio" name="InterestType" value="@((int)type)" @(type == InterestType.Work ? "checked" : "") />
                                        <span>
                                            <strong>@type</strong>
                                            <span class="d-block small text-muted">
                                                @(type == InterestType.Work ? "Join as team member" : type == InterestType.Invest ? "Invest money" : "Work + Invest")
                                            </span>
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div id="workSection">
                            <label class="form-label fw-semibold">Roles you can fill</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var role in Model.RolesNeeded)
                                {
                                    <label class="sc-checkbox-card border rounded px-3 py-2" style="cursor:pointer">
                                        <input type="checkbox" name="SelectedRoles" value="@role" class="form-check-input me-1" />@role
                                    </label>
                                }
                            </div>
                        </div>
                        <div id="investSection" style="display:none" class="mt-3">
                            <label class="form-label fw-semibold">Investment Amount (₹)</label>
                            <input type="number" name="ProposedInvestmentAmount" class="form-control" min="1000" step="1000" placeholder="e.g. 25000" />
                        </div>
                        <div class="mt-3">
                            <label class="form-label fw-semibold">Message (optional)</label>
                            <textarea name="Message" class="form-control" rows="2" placeholder="Why are you interested?"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="submitInterestBtn" class="btn btn-accent">
                            <span class="spinner-border spinner-border-sm d-none me-1"></span>
                            Submit Interest
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Report Modal -->
    <div class="modal fade" id="reportModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius:16px">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-flag-fill me-2"></i>Report Idea</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Ideas" asp-action="ReportSpam" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-body">
                        <p>Why are you reporting this idea?</p>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="reason" id="r1" value="Spam or misleading" required>
                            <label class="form-check-label" for="r1">Spam or misleading</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="reason" id="r2" value="Inappropriate content">
                            <label class="form-check-label" for="r2">Inappropriate content</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="reason" id="r3" value="Plagiarism">
                            <label class="form-check-label" for="r3">Plagiarism</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="reason" id="r4" value="Other">
                            <label class="form-check-label" for="r4">Other</label>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Report</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- History Modal -->
    <div class="modal fade" id="historyModal" tabindex="-1" aria-labelledby="historyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header bg-white border-bottom-0 rounded-top-4">
                    <h5 class="modal-title fw-bold" id="historyModalLabel"><i class="bi bi-clock-history me-2 text-primary"></i>Version History</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0 bg-white" id="historyModalBody">
                    <div class="p-5 text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-muted mt-3">Loading history...</p>
                    </div>
                </div>
                <div class="modal-footer border-top-0 bg-white rounded-bottom-4">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Compare Version Modal -->
    <div class="modal fade" id="compareModal" tabindex="-1" aria-labelledby="compareModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header bg-white border-bottom-0 rounded-top-4">
                    <h5 class="modal-title fw-bold" id="compareModalLabel"><i class="bi bi-layout-split me-2 text-primary"></i>Compare Versions</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0 bg-white" id="compareModalBody">
                    <div class="p-5 text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-muted mt-3">Loading comparison...</p>
                    </div>
                </div>
                <div class="modal-footer border-top-0 bg-white rounded-bottom-4">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Restore Confirmation Modal -->
    <div class="modal fade" id="restoreConfirmModal" tabindex="-1" aria-labelledby="restoreConfirmLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header bg-warning bg-opacity-10 border-bottom-0 rounded-top-4">
                    <h5 class="modal-title fw-bold text-warning" id="restoreConfirmLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Restore Version</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-arrow-counterclockwise text-warning" style="font-size: 3rem;"></i>
                    <p class="mt-3 mb-1 fw-semibold">Are you sure you want to restore <span id="restoreVersionLabel">this version</span>?</p>
                    <p class="text-muted small mb-0">Your current idea content will be saved as a new version before restoring. No data will be lost.</p>
                </div>
                <div class="modal-footer border-top-0 justify-content-center rounded-bottom-4">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning" id="confirmRestoreBtn" onclick="executeRestore()">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Restore Version
                    </button>
                </div>
            </div>
        </div>
    </div>

}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const shareBtns = document.querySelectorAll('.share-btn');
        shareBtns.forEach(btn => {
            btn.addEventListener('click', async () => {
                const url = window.location.href;
                const title = @Json.Serialize(Model.Title);
                
                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: title,
                            url: url
                        });
                    } catch (err) {
                        console.log('Share dismissed');
                    }
                } else {
                    try {
                        await navigator.clipboard.writeText(url);
                        alert('Link copied to clipboard!');
                    } catch (err) {
                        console.error('Failed to copy', err);
                    }
                }
            });
        });
    });

    // === Version History Functions ===

    function loadIdeaHistory(ideaId) {
        const modalBody = document.getElementById('historyModalBody');
        modalBody.innerHTML = `
            <div class="p-5 text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="text-muted mt-3">Loading history...</p>
            </div>
        `;

        fetch(`/Ideas/GetHistory/${ideaId}`)
            .then(response => response.text())
            .then(html => {
                modalBody.innerHTML = html;
            })
            .catch(error => {
                console.error('Error loading history:', error);
                modalBody.innerHTML = `
                    <div class="p-4 text-center text-danger">
                        <i class="bi bi-exclamation-triangle fs-1"></i>
                        <p class="mt-2">Failed to load history. Please try again.</p>
                    </div>
                `;
            });
    }

    function compareVersion(ideaId, historyId) {
        // Hide history modal, show compare modal
        const historyModal = bootstrap.Modal.getInstance(document.getElementById('historyModal'));
        if (historyModal) historyModal.hide();

        const compareModalEl = document.getElementById('compareModal');
        const compareModal = new bootstrap.Modal(compareModalEl);
        const compareBody = document.getElementById('compareModalBody');

        compareBody.innerHTML = `
            <div class="p-5 text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="text-muted mt-3">Loading comparison...</p>
            </div>
        `;

        compareModal.show();

        fetch(`/Ideas/CompareVersion?ideaId=${ideaId}&historyId=${historyId}`)
            .then(response => response.text())
            .then(html => {
                compareBody.innerHTML = html;
            })
            .catch(error => {
                console.error('Error loading comparison:', error);
                compareBody.innerHTML = `
                    <div class="p-4 text-center text-danger">
                        <i class="bi bi-exclamation-triangle fs-1"></i>
                        <p class="mt-2">Failed to load comparison. Please try again.</p>
                    </div>
                `;
            });
    }

    let pendingRestoreIdeaId = null;
    let pendingRestoreHistoryId = null;

    function confirmRestore(ideaId, historyId, versionNumber) {
        pendingRestoreIdeaId = ideaId;
        pendingRestoreHistoryId = historyId;

        document.getElementById('restoreVersionLabel').textContent = `Version ${versionNumber}`;

        // Hide history modal, show confirm modal
        const historyModal = bootstrap.Modal.getInstance(document.getElementById('historyModal'));
        if (historyModal) historyModal.hide();

        const restoreModal = new bootstrap.Modal(document.getElementById('restoreConfirmModal'));
        restoreModal.show();
    }

    function executeRestore() {
        if (!pendingRestoreIdeaId || !pendingRestoreHistoryId) return;

        const btn = document.getElementById('confirmRestoreBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Restoring...';

        const token = scCsrfToken();
        const formData = new FormData();
        formData.append('ideaId', pendingRestoreIdeaId);
        formData.append('historyId', pendingRestoreHistoryId);

        fetch('/Ideas/RestoreVersion', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Close the modal and refresh the page
                const restoreModal = bootstrap.Modal.getInstance(document.getElementById('restoreConfirmModal'));
                if (restoreModal) restoreModal.hide();
                location.reload();
            } else {
                alert(data.message || 'Failed to restore version.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-arrow-counterclockwise me-1"></i>Restore Version';
            }
        })
        .catch(error => {
            console.error('Error restoring version:', error);
            alert('An error occurred while restoring. Please try again.');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-counterclockwise me-1"></i>Restore Version';
        });
    }
</script>

