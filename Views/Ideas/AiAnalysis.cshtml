@model IdeaDetailViewModel
@using StartupConnect.Services
@{
    ViewData["Title"] = "AI Analysis - " + Model.Title;
    var job = ViewBag.Job as AnalysisJobStatus;
    var aiConfigured = ViewBag.AiConfigured as bool? ?? false;
    var generating = job != null && (job.State == AnalysisJobState.Queued || job.State == AnalysisJobState.Running);
}

<section class="sc-page-header">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1><i class="bi bi-robot text-accent me-2"></i> AI Idea Analysis</h1>
            <p class="opacity-75 mb-0">Analysis for: <strong>@Model.Title</strong></p>
        </div>
        <div>
            <a asp-action="MyIdeas" class="btn btn-outline-dark"><i class="bi bi-arrow-left me-2"></i>Back to My Ideas</a>
        </div>
    </div>
</section>

<div class="container pb-5">
    @if (Model.Status != StartupConnect.Models.IdeaStatus.Approved)
    {
        <div class="alert alert-info rounded-4 d-flex align-items-center gap-2">
            <i class="bi bi-hourglass-split"></i>
            <span>This idea is <strong>@Model.Status</strong> — only you and our reviewers can see it until it's approved.</span>
        </div>
    }
    @if (Model.Analysis != null && generating)
    {
        <div class="alert alert-warning rounded-4 d-flex align-items-center gap-2" id="aiGenerating" data-idea-id="@Model.Id">
            <span class="spinner-border spinner-border-sm"></span>
            <span id="aiStatusText">A fresh analysis is being generated. This page will refresh automatically when it's ready.</span>
        </div>
    }
    @if (Model.Analysis != null)
    {
        <div class="sc-detail-section mb-4 shadow-sm bg-white" style="border-radius: 12px; position: relative;">
            <div class="position-absolute top-0 end-0 p-3">
                <span class="badge bg-accent bg-opacity-10 text-accent fs-5 px-3 py-2">
                    <i class="bi bi-stars me-1"></i> AI Score: @Model.Analysis.OverallScore/100
                </span>
            </div>
            
            <div class="mb-5 mt-2">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Executive Summary</h5>
                <p class="text-muted fs-5">@Model.Analysis.Summary</p>
            </div>
            
            <div class="mb-5">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Problem & Solution Assessment</h5>
                <p class="text-muted" style="white-space: pre-wrap;">@Model.Analysis.ProblemsAndSolutions</p>
            </div>
            
            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <div class="h-100 p-4 bg-white rounded shadow-sm border-start border-4 border-primary">
                        <h6 class="fw-bold fs-5"><i class="bi bi-bullseye me-2 text-primary"></i>Target Users</h6>
                        <p class="mb-0 text-muted" style="white-space: pre-wrap;">@Model.Analysis.TargetUsers</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="h-100 p-4 bg-white rounded shadow-sm border-start border-4 border-success">
                        <h6 class="fw-bold fs-5"><i class="bi bi-graph-up-arrow me-2 text-success"></i>Market Potential</h6>
                        <p class="mb-0 text-muted" style="white-space: pre-wrap;">@Model.Analysis.MarketPotential</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="h-100 p-4 bg-white rounded shadow-sm border-start border-4 border-warning">
                        <h6 class="fw-bold fs-5"><i class="bi bi-cash-stack me-2 text-warning"></i>Revenue Models</h6>
                        <p class="mb-0 text-muted" style="white-space: pre-wrap;">@Model.Analysis.RevenueModels</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="h-100 p-4 bg-white rounded shadow-sm border-start border-4 border-danger">
                        <h6 class="fw-bold fs-5"><i class="bi bi-shield-exclamation me-2 text-danger"></i>Risks & Challenges</h6>
                        <p class="mb-0 text-muted" style="white-space: pre-wrap;">@Model.Analysis.Risks</p>
                    </div>
                </div>
            </div>

            <div class="mb-5">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-people-fill me-2 text-info"></i>Team Suggestions</h5>
                <p class="text-muted">@Model.Analysis.TeamSuggestions</p>
            </div>

            @if (Model.Analysis.SimilarIdeas.Any())
            {
                <div class="mb-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-files me-2 text-secondary"></i>Similar Concepts Detected</h5>
                    <div class="row g-3">
                        @foreach (var similar in Model.Analysis.SimilarIdeas)
                        {
                            <div class="col-md-6">
                                <div class="card h-100 border-0 bg-white shadow-sm">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between mb-2">
                                            <strong class="text-dark fs-5">@similar.Title</strong>
                                            <span class="badge bg-secondary fs-6">@similar.MatchPercentage% match</span>
                                        </div>
                                        <p class="text-muted mb-0">@similar.Detail</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            
            <div class="text-end mt-5 pt-3 border-top">
                <small class="text-muted me-3">Analysis generated on @Model.Analysis.GeneratedAt.ToString("MMM dd, yyyy HH:mm")</small>
                @if ((Model.IsOwner || User.IsInRole("Admin")) && aiConfigured && !generating)
                {
                    <form asp-action="RegenerateAnalysis" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <!-- Redirect back to AiAnalysis instead of Detail after regeneration -->
                        <input type="hidden" name="returnUrl" value="AiAnalysis" />
                        <button type="submit" class="btn btn-accent" onclick="this.innerHTML='<span class=\'spinner-border spinner-border-sm me-1\'></span> Regenerating...';">
                            <i class="bi bi-arrow-clockwise me-1"></i>Regenerate Analysis
                        </button>
                    </form>
                }
            </div>
        </div>
    }
    else if (generating)
    {
        <div class="sc-detail-section mb-4 text-center p-5 bg-white rounded shadow-sm" id="aiGenerating" data-idea-id="@Model.Id">
            <div class="spinner-border text-accent mb-3" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Generating…</span>
            </div>
            <h4 class="fw-bold text-accent">Generating your AI analysis…</h4>
            <p class="text-muted fs-5 mb-2" id="aiStatusText">@(job!.State == AnalysisJobState.Queued ? "Your idea is in the queue." : "Our AI is reading your idea now.")</p>
            <p class="text-muted small mb-0">This usually takes less than a minute. This page updates automatically — feel free to keep it open.</p>
        </div>
    }
    else
    {
        <div class="sc-detail-section mb-4 text-center p-5 bg-white rounded shadow-sm">
            <i class="bi bi-robot text-muted" style="font-size: 3rem;"></i>
            <h4 class="fw-bold mt-3">@(aiConfigured ? "We couldn't finish the AI analysis" : "No AI analysis yet")</h4>
            <p class="text-muted fs-5 mb-4">@(job?.Message ?? (aiConfigured ? AiMessages.GenericFailure : AiMessages.NotConfigured))</p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                @if (aiConfigured)
                {
                    <form asp-action="RegenerateAnalysis" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="AiAnalysis" />
                        <button type="submit" class="btn btn-accent"><i class="bi bi-arrow-clockwise me-1"></i>Try again</button>
                    </form>
                }
                <a asp-action="MyIdeas" class="btn btn-outline-dark"><i class="bi bi-arrow-left me-2"></i>Back to My Ideas</a>
            </div>
        </div>
    }
</div>

@section Scripts {
        <script>
            (function () {
                var el = document.getElementById('aiGenerating');
                if (!el) return;
                var id = el.getAttribute('data-idea-id');
                var text = document.getElementById('aiStatusText');
                var attempts = 0;
                function poll() {
                    attempts++;
                    fetch('/Ideas/AnalysisStatus/' + encodeURIComponent(id), { headers: { 'Accept': 'application/json' } })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (data) {
                            if (!data) return schedule();
                            if (data.state === 'ready' || data.state === 'failed' || data.state === 'none') {
                                window.location.reload();
                                return;
                            }
                            text.textContent = data.state === 'queued' ? 'Your idea is in the queue.' : 'Our AI is reading your idea now.';
                            schedule();
                        })
                        .catch(schedule);
                }
                function schedule() {
                    // Poll every 3s, slowing to 10s after a minute.
                    setTimeout(poll, attempts < 20 ? 3000 : 10000);
                }
                schedule();
            })();
        </script>
    }
