@model List<StartupConnect.ViewModels.IdeaCardViewModel>
@{
    ViewData["Title"] = "Explore Ideas";
    var categories = ViewBag.Categories as List<StartupConnect.Models.Category>;
    var filter = ViewContext.HttpContext.Request.Query;
    int totalPages = ViewBag.TotalPages;
    int currentPage = int.TryParse(filter["Page"], out var p) ? p : 1;
}

<section class="sc-page-header" data-aos="fade-down">
    <div class="container">
        <h1>Explore Startup Ideas</h1>
        <p class="opacity-75 mb-0">Verified ideas looking for teammates and investors</p>
    </div>
</section>

<div class="container pb-5">
    <div class="row g-4">
        <!-- Filters -->
        <div class="col-lg-3" data-aos="fade-right">
            <div class="sc-filter-panel">
                <h6 class="fw-bold mb-3"><i class="bi bi-funnel me-2"></i>Filters</h6>
                <form method="get" asp-action="Browse">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Search</label>
                        <input name="Search" value="@filter["Search"]" class="form-control form-control-sm" placeholder="Keyword..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Category</label>
                        <select name="CategoryId" class="form-select form-select-sm">
                            <option value="">All Categories</option>
                            @if (categories != null)
                            {
                                foreach (var c in categories)
                                {
                                    <option value="@c.Id" selected="@(filter["CategoryId"] == c.Id.ToString())">@c.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Sort By</label>
                        <select name="SortBy" class="form-select form-select-sm">
                            <option value="newest" selected="@(filter["SortBy"] != "popular" && filter["SortBy"] != "fund-low" && filter["SortBy"] != "ai-score")">Newest</option>
                            <option value="popular" selected="@(filter["SortBy"] == "popular")">Most Popular</option>
                            <option value="fund-low" selected="@(filter["SortBy"] == "fund-low")">Lowest Fund Need</option>
                            <option value="ai-score" selected="@(filter["SortBy"] == "ai-score")">🤖 AI Score</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Required Roles</label>
                        <input name="RolesNeeded" value="@filter["RolesNeeded"]" class="form-control form-control-sm" placeholder="e.g. Developer, Designer" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Min Engagement Score</label>
                        <input type="number" name="MinEngagementScore" value="@filter["MinEngagementScore"]" class="form-control form-control-sm" placeholder="0" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Target Funding</label>
                        <div class="input-group input-group-sm">
                            <input type="number" name="MinFund" value="@filter["MinFund"]" class="form-control" placeholder="Min" />
                            <span class="input-group-text">-</span>
                            <input type="number" name="MaxFund" value="@filter["MaxFund"]" class="form-control" placeholder="Max" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary-sc btn-sm w-100">Apply Filters</button>
                </form>
            </div>
        </div>

        <!-- Ideas Grid -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">@ViewBag.TotalCount ideas found</span>
                <a asp-action="Trending" class="btn btn-outline-primary btn-sm"><i class="bi bi-fire me-1"></i> View Trending Ideas</a>
            </div>
            @if (Model.Any())
            {
                <div class="row g-4">
                    @foreach (var idea in Model)
                    {
                        <div class="col-md-6 col-xl-4" data-aos="fade-up">@await Html.PartialAsync("_IdeaCard", idea)</div>
                    }
                </div>
                @if (totalPages > 1)
                {
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Browse" asp-route-Page="@i"
                                       asp-route-Search="@filter["Search"]" asp-route-CategoryId="@filter["CategoryId"]"
                                       asp-route-SortBy="@filter["SortBy"]">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-search fs-1 text-muted d-block mb-3"></i>
                    <h5>No ideas found</h5>
                    <p class="text-muted">Try adjusting your filters or check back later.</p>
                </div>
            }
        </div>
    </div>
</div>
