@model List<StartupConnect.ViewModels.IdeaCardViewModel>
@{
    ViewData["Title"] = "Trending Ideas";
}

<section class="sc-page-header py-5" data-aos="fade-down">
    <div class="container text-center">
        <h1><i class="bi bi-fire text-warning"></i> Trending Ideas</h1>
        <p class="opacity-75 mb-0">Ranked by recent activity — unique views, likes, comments and interest, with the last few days counting most.</p>
    </div>
</section>

<div class="container py-5">
    @if (Model.Any())
    {
        <div class="row g-4">
            @for (var i = 0; i < Model.Count; i++)
            {
                var idea = Model[i];
                <div class="col-md-6 col-lg-4 position-relative" data-aos="fade-up">
                    <span class="sc-trend-rank badge @(i < 3 ? "bg-warning text-dark" : "bg-light text-dark border") shadow-sm position-absolute z-3" style="top:-10px;left:4px" aria-label="Rank @(i + 1)">#@(i + 1)</span>
                    @await Html.PartialAsync("_IdeaCard", idea)
                </div>
            }
        </div>
        <div class="text-center mt-5">
            <a asp-action="Browse" asp-route-SortBy="trending" class="btn btn-outline-primary rounded-pill">See all ideas by trend <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
    }
    else
    {
        <div class="sc-empty-state">
            <div class="sc-empty-icon"><i class="bi bi-activity"></i></div>
            <h5>No trending ideas right now</h5>
            <p class="text-muted">Nothing has been published yet. Explore ideas or submit your own to get things moving.</p>
            <a asp-action="Browse" class="btn btn-primary-sc rounded-pill">Explore ideas</a>
        </div>
    }
</div>
